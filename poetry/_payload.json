[{"data":1,"prerenderedAt":2361},["ShallowReactive",2],{"forms-config":3,"poetry":50},{"id":4,"title":5,"body":6,"contactForm":13,"contactMessages":27,"description":10,"extension":36,"meta":37,"navigation":38,"newsletterMessages":39,"path":46,"seo":47,"stem":48,"__hash__":49},"forms/forms.md","Forms",{"type":7,"value":8,"toc":9},"minimark",[],{"title":10,"searchDepth":11,"depth":11,"links":12},"",2,[],{"subjects":14},[15,17,19,21,23,25],{"label":16,"value":16},"General Inquiry",{"label":18,"value":18},"Game Support",{"label":20,"value":20},"Business Partnership",{"label":22,"value":22},"Press/Media",{"label":24,"value":24},"Bug Report",{"label":26,"value":26},"Other",{"success":28,"error":32},{"title":29,"description":30,"icon":31},"Message sent!","Thank you for your message! We'll get back to you soon.","i-lucide-check-circle",{"title":33,"description":34,"icon":35},"Error","There was an error sending your message. Please try again.","i-lucide-x-circle","md",{},true,{"success":40,"error":43},{"title":41,"description":42,"icon":31},"Success!","You're subscribed to our newsletter",{"title":44,"description":45,"icon":35},"Subscription failed","Failed to subscribe. Please try again.","/forms",{"title":5,"description":10},"forms","du_85TeF-9I_awDNIjj8_m1mviV_FSSoTzcj0WDjaa4",[51],{"id":52,"title":53,"author":54,"authorNote":55,"body":56,"date":2350,"description":66,"excerpt":55,"extension":36,"featured":2351,"image":55,"meta":2352,"navigation":38,"path":2353,"published":38,"seo":2354,"slug":61,"stem":2355,"tags":2356,"thumbnail":55,"__hash__":2360},"poetry/poetry/glass-walls-briarheart.md","Glass Walls, Briarhearts","Shrike Publishing",null,{"type":7,"value":57,"toc":2326},[58,62,67,71,74,77,80,83,86,89,92,95,98,101,104,107,110,113,116,119,122,124,127,133,140,143,146,149,152,155,158,161,164,167,170,173,175,178,181,184,187,190,193,195,198,201,204,207,210,213,215,221,224,227,230,233,236,239,242,245,248,251,254,257,260,263,266,269,272,275,278,281,284,287,290,293,296,299,30