2145,2148,2151,2154,2157,2160,2163,2166,2169,2172,2175,2178,2181,2184,2187,2190,2193,2196,2199,2202,2204,2210,2213,2216,2219,2222,2225,2228,2230,2233,2236,2239,2241,2244,2247,2253,2255,2257,2260,2265,2267,2269,2272,2277,2279,2281,2284,2287,2290,2293,2296,2299,2301,2304,2307,2310,2313,2316,2318,2321,2324,2327,2330,2333,2336,2338,2344,2347,2350,2353,2356,2359,2362,2365,2368,2371,2374,2377,2380,2383,2386,2389,2392,2395,2398,2401,2404,2407,2410,2413,2416,2419,2422,2425,2428,2431,2434,2437,2440,2443,2446,2449,2452,2455,2458],[193,194,186],"h1",{"id":195},"glass-walls-briarhearts",[197,198,200],"h2",{"id":199},"a-poetry-collection","A poetry collection.",[202,203,204],"p",{},"R. Val",[202,206,207],{},"— — — — —",[202,209,210],{},"An introduction is a call to defense,",[202,212,213],{},"Who am I? Why write this down?",[202,215,216],{},"Why is this worth your time?",[202,218,219],{},"I’m not the one who can answer that.",[202,221,222],{},"In the following text, I will attempt to communicate something.",[202,224,225],{},"The shape and tenor is unknown to me,",[202,227,228],{},"As it is to you.",[202,230,231],{},"But It is within me and I need it to not be.",[202,233,234],{},"It will take the form of deception.",[202,236,237],{},"Not lies, no.",[202,239,240],{},"Refractions,",[202,242,243],{},"Details cast through prisms and reshaped.",[202,245,246],{},"You will see what you will.",[202,248,249],{},"You, me, some third party.",[202,251,252],{},"It will be true enough.",[202,254,255],{},"Humans are creatures of narrative.",[202,257,207],{},[202,259,260],{},"Press enter or click to view image in full size",[202,262,263],{},[264,265],"img",{"alt":266,"src":267},"","https://miro.medium.com/v2/resize:fit:1050/1*-9mWwB3PnDg3iJ5gppfOSw@2x.jpeg",[197,269,271],{"id":270},"_1979-the-last-age",[272,273,274],"strong",{},"1979, The Last Age",[202,276,277],{},"In murky mornings you sing",[202,279,280],{},"The song of those who came before.",[202,282,283],{},"By marsh, river, and sea,",[202,285,286],{},"Eons long endured to put you",[202,288,289],{},"In your appointed place.",[202,291,292],{},"~",[202,294,295],{},"So many once sang,",[202,297,298],{},"Kindred steadfast and true.",[202,300,301],{},"Less now, soon none.",[202,303,304],{},"Just you,",[202,306,307],{},"And the tune that ends all things.",[202,309,292],{},[202,311,312],{},"Do you sing for another?",[202,314,315],{},"One like you, dusky and mottled.",[202,317,318],{},"Do you sing for their ghosts?",[202,320,321],{},"That you might tear the veil.",[202,323,324],{},"Do you sing because it is you?",[202,326,327],{},"And that is all you know how to do.",[202,329,292],{},[202,331,332],{},"A last cry to breach expanse so vast.",[202,334,335],{},"You carry them on your wings.",[202,337,338],{},"Your brothers did too,",[202,340,341],{},"Gone now and soon you.",[202,343,344],{},"But let the coasts know,",[202,346,347],{},"Of the sparrows that were once here.",[202,349,207],{},[197,351,353],{"id":352},"to-the-unknown-assailant-currently-residing-in-my-bedroom",[272,354,355],{},"To the Unknown Assailant Currently Residing in my Bedroom",[202,357,358],{},"What did you feel,",[202,360,361],{},"That terrible day?",[202,363,364],{},"When you found yourself",[202,366,367],{},"Trapped in half washed locks?",[202,369,370],{},"The forest of some giant,",[202,372,373],{},"Careless and distant.",[202,375,376],{},"Thrash and pull,",[202,378,379],{},"anything to break free.",[202,381,382],{},"You cried for help,",[202,384,385],{},"For kin or god,",[202,387,388],{},"None heard you.",[202,390,391],{},"I didn’t help you,",[202,393,394],{},"I didn’t know,",[202,396,397],{},"I didn’t understand,",[202,399,400],{},"I’m sorry.",[202,402,403],{},"Would ask what you think,",[202,405,406],{},"But you don’t think, do you?",[202,408,409],{},"A life of hunger, rage, and fear.",[202,411,412],{},"It’s still a life.",[202,414,415],{},"Must’ve been deranged and miserable,",[202,417,418],{},"When I pulled you out.",[202,420,421],{},"Never even saw more than a glimpse.",[202,423,424],{},"Black carapace,",[202,426,427],{},"Soft and warm.",[202,429,430],{},"You clung to my hand so tight,",[202,432,433],{},"When you stung me.",[202,435,436],{},"Please leave.",[202,438,207],{},[197,440,442],{"id":441},"in-memory-of-private-riley-jacobs-9871011",[272,443,444],{},"In Memory of Private Riley Jacobs, 987–1011",[202,446,447],{},"“Fearfully and wonderfully made.”",[202,449,450],{},"True for some,",[202,452,453],{},"Not you.",[202,455,456],{},"Doomed as soon as you walk on screen.",[202,458,292],{},[202,460,461],{},"The shots start,",[202,463,464],{},"You’re already gone.",[202,466,467],{},"Story cut short,",[202,469,470],{},"That others would be told.",[202,472,292],{},[202,474,475],{},"No way out,",[202,477,478],{},"No path forward.",[202,480,481],{},"A prop in the dance,",[202,483,484],{},"Of rook and lion.",[202,486,292],{},[202,488,489],{},"Did you know?",[202,491,492],{},"Scared to hell.",[202,494,495],{},"Did it hurt?",[202,497,498],{},"The heat in your side.",[202,500,292],{},[202,502,503],{},"Did your mother dream for you?",[202,505,506],{},"A hero of old,",[202,508,509],{},"Dashing and bold,",[202,511,512],{},"Draped in violet.",[202,514,292],{},[202,516,517],{},"A whole life lived,",[202,519,520],{},"A whole life wasted,",[202,522,523],{},"On a connecting paragraph,",[202,525,526],{},"And a grim fucking punchline.",[202,528,292],{},[202,530,531],{},"Your path unfolded,",[202,533,534],{},"All roads lead to",[202,536,537],{},"Your appointed place.",[202,539,540],{},"The boots of your betters.",[202,542,292],{},[202,544,545],{},"Ask me why,",[202,547,548],{},"Beg that this fate",[202,550,551],{},"may pass from you.",[202,553,554],{},"Another chance to be great.",[202,556,292],{},[202,558,559],{},"Find no mercy,",[202,561,562],{},"For I am the Lord your God.",[202,564,565],{},"Might justifies itself,",[202,567,568],{},"And is an architect of ruin.",[202,570,292],{},[202,572,573],{},"But let someone weep for the forgotten,",[202,575,576],{},"For the spaces filled in",[202,578,579],{},"With bright eyed innocents,",[202,581,582],{},"Cut down in the afterthought.",[202,584,207],{},[197,586,588],{"id":587},"lagoonborn",[272,589,590],{},"Lagoonborn",[202,592,593],{},"Your love has no price,",[202,595,596],{},"Not the blood cost of before.",[202,598,599],{},"Celebrated me,",[202,601,602],{},"my demented dance.",[202,604,605],{},"Tell me dear,",[202,607,608],{},"I may wade in your waters a while longer.",[202,610,611],{},"Make me believe,",[202,613,614],{},"Make me wish to see,",[202,616,617],{},"The world through amber eyes.",[202,619,620],{},"A world of hope and beauty,",[202,622,623],{},"that pales in your wake,",[202,625,626],{},"That I did not know existed before you.",[202,628,629],{},"Heavens bless those who bless you,",[202,631,632],{},"Hells take those who do you harm.",[202,634,635],{},"Guide my hands,",[202,637,638],{},"May I be half the woman",[202,640,641],{},"You always deserved.",[202,643,644],{},"This road will end, in parting or the grave,",[202,646,647],{},"As all roads do.",[202,649,650],{},"But for as long as I am able,",[202,652,653],{},"I wish to be yours true.",[202,655,207],{},[197,657,659],{"id":658},"draconic-11",[272,660,661],{},"Draconic 11",[202,663,664],{},"So lick your wounds,",[202,666,667],{},"And I’ll keep watch.",[202,669,670],{},"Tell me your stories,",[202,672,673],{},"Pretend it’s the first time.",[202,675,292],{},[202,677,678],{},"Magnets of like charge repulsed,",[202,680,681],{},"Yet we are the same.",[202,683,684],{},"Players of the dark game.",[202,686,687],{},"Practicers of sanguine rituals.",[202,689,292],{},[202,691,692],{},"Never to align,",[202,694,695],{},"Sworn to destroy,",[202,697,698],{},"That which each other holds dear.",[202,700,701],{},"But what do we really believe in?",[202,703,292],{},[202,705,706],{},"Brought together by two choices,",[202,708,709],{},"Sustained by dozens after.",[202,711,712],{},"A friendship,",[202,714,715],{},"An imploding submarine.",[202,717,292],{},[202,719,720],{},"So go around again,",[202,722,723],{},"One more time.",[202,725,726],{},"We could get it right.",[202,728,729],{},"Just a dream, not always bad.",[202,731,292],{},[202,733,734],{},"So stay away,",[202,736,737],{},"Wish you well, curse me to hell.",[202,739,740],{},"When the world grovels at your feet,",[202,742,743],{},"I’ll be a true believer.",[202,745,207],{},[197,747,749],{"id":748},"the-watcher",[272,750,751],{},"The Watcher",[202,753,754],{},"Another day, what should be the aftermath.",[202,756,757],{},"A number on a screen tells me you’re still here.",[202,759,760],{},"Still here, above and beyond, out of reach.",[202,762,763],{},"I should feel safe, my guardian angel, but you’re no protector.",[202,765,766],{},"Your hate oozes down my spine, sickening and foul.",[202,768,769],{},"“Am I as hideous as you say?”",[202,771,772],{},"I type the thought, close the screen, and move on.",[202,774,775],{},"You’ll be there when I’m back, you’ll always be there.",[202,777,778],{},"What did I do to deserve this curse?",[202,780,781],{},"What did you do to be bound in kind?",[202,783,784],{},"That whenever I act, you watch.",[202,786,787],{},"Still here, still here.",[202,789,207],{},[197,791,793],{"id":792},"_711-927-pm",[272,794,795],{},"7–11, 9:27 PM",[202,797,798],{},"I fear you,",[202,800,801],{},"stranger in my way.",[202,803,804],{},"Made to share moment brief,",[202,806,807],{},"To share this space too small.",[202,809,292],{},[202,811,798],{},[202,813,814],{},"Eyes I cannot read.",[202,816,817],{},"A smile hollow,",[202,819,820],{},"Is that a smile?",[202,822,292],{},[202,824,825],{},"I hate you,",[202,827,828],{},"Enemy, alien, unknown.",[202,830,831],{},"Seed of Esau,",[202,833,834],{},"Born of adversity.",[202,836,292],{},[202,838,839],{},"I love you,",[202,841,842],{},"Fellow wandering soul.",[202,844,845],{},"Human, same as me.",[202,847,848],{},"More alike than not.",[202,850,851],{},"\u003C",[202,853,854],{},"I weep for you,",[202,856,857],{},"Child of the Last Age.",[202,859,860],{},"Swallowed by that cold maw,",[202,862,863],{},"Shoulder to shoulder.",[202,865,292],{},[202,867,868],{},"I hope for you,",[202,870,871],{},"Your joys and triumphs.",[202,873,874],{},"That you bring beauty,",[202,876,877],{},"Into a world grown dark.",[202,879,292],{},[202,881,882],{},"I fear me,",[202,884,885],{},"What you must see.",[202,887,888],{},"Half mad and scourged,",[202,890,891],{},"Less than once was.",[202,893,292],{},[202,895,798],{},[202,897,898],{},"Thoughts a mystery.",[202,900,901],{},"Will you kill me?",[202,903,904],{},"Would that be so bad?",[202,906,292],{},[202,908,909],{},"I fear you.",[202,911,292],{},[202,913,909],{},[202,915,207],{},[197,917,919],{"id":918},"momentum",[272,920,921],{},"Momentum",[202,923,924],{},"Keep going.",[202,926,927],{},"Step 1, Step 2,",[202,929,930],{},"Step 3, Step 4.",[202,932,933],{},"Running now,",[202,935,936],{},"Lines upon lines.",[202,938,939],{},"What are you trying to get out?",[202,941,942],{},"Snag on the thought,",[202,944,945],{},"Crash and tumble.",[202,947,948],{},"Lay there in the dark.",[202,950,951],{},"A piece is as incomplete as you.",[202,953,954],{},"Try again,",[202,956,957],{},"Step 1.",[202,959,960],{},"No,",[202,962,963],{},"It doesn’t feel the same.",[202,965,954],{},[202,967,927],{},[202,969,970],{},"You need this to hurt,",[202,972,973],{},"How else will you feel alive?",[202,975,976],{},"Step 1,",[202,978,979],{},"You should call her.",[202,981,976],{},[202,983,984],{},"The words flowed through you then.",[202,986,976],{},[202,988,989],{},"You’re so sober.",[202,991,976],{},[202,993,994],{},"The bar is just down the street.",[202,996,976],{},[202,998,999],{},"Another delay, another thing wrong.",[202,1001,976],{},[202,1003,1004],{},"Maybe the problem is you.",[202,1006,1007],{},"Breathe.",[202,1009,1010],{},"Breathe again,",[202,1012,1013],{},"Become an instrument.",[202,1015,1016],{},"Fingers at the keys.",[202,1018,1019],{},"Type,",[202,1021,976],{},[202,1023,1024],{},"Step 2,",[202,1026,1027],{},"Step 3,",[202,1029,1030],{},"Running again.",[202,1032,1033],{},"Never stop.",[202,1035,207],{},[197,1037,1039],{"id":1038},"poetry-wont-fix-this",[272,1040,1041],{},"Poetry Won’t Fix This",[202,1043,1044],{},"Another skin,",[202,1046,1047],{},"Freshly shorn,",[202,1049,1050],{},"Newly worn.",[202,1052,1053],{},"Do this so easy,",[202,1055,1056],{},"Call a stranger’s face your own,",[202,1058,1059],{},"Never at home when you’re alone.",[202,1061,1062],{},"Play the part,",[202,1064,1065],{},"Actor,",[202,1067,1068],{},"Impostor,",[202,1070,1071],{},"Changeling.",[202,1073,1074],{},"Another way to escape yourself.",[202,1076,1077],{},"Another hat,",[202,1079,1080],{},"A costume change,",[202,1082,1083],{},"It won’t save you.",[202,1085,1086],{},"The rot’s still there,",[202,1088,1089],{},"Festering in bone.",[202,1091,1092],{},"You already know,",[202,1094,1095],{},"Do it for the art,",[202,1097,1098],{},"Play, pretend, perfect.",[202,1100,1101],{},"Getting so good at this,",[202,1103,1104],{},"Find another way.",[202,1106,1107],{},"Repeat, refresh",[202,1109,1110],{},"An answer for a time.",[202,1112,1113],{},"Another narrative,",[202,1115,1116],{},"To justify the void.",[202,1118,207],{},[197,1120,1122],{"id":1121},"the-last-verse-of-runner",[272,1123,1124],{},"The Last Verse of Runner",[202,1126,1127],{},"Sticking your nose in bear traps",[202,1129,1130],{},"Like it never went out of style.",[202,1132,1133],{},"Another tragic girlie,",[202,1135,1136],{},"And her solipsistic deathwish.",[202,1138,1139],{},"Daring, are we?",[202,1141,292],{},[202,1143,1144],{},"Moths wouldn’t soar to flames,",[202,1146,1147],{},"The way you do",[202,1149,1150],{},"When you need to hurt.",[202,1152,292],{},[202,1154,1155],{},"What will it be?",[202,1157,1158],{},"A new drug habit?",[202,1160,1161],{},"A new mean brunette?",[202,1163,1164],{},"Night driving, headlights off?",[202,1166,1167],{},"Skip it, open your veins.",[202,1169,292],{},[202,1171,1172],{},"Say it makes you feel alive,",[202,1174,1175],{},"Still as dead as ever.",[202,1177,1178],{},"Say it’s for the art.",[202,1180,1181],{},"A single success at the foot",[202,1183,1184],{},"Of a mountain of waste.",[202,1186,292],{},[202,1188,1189],{},"Say it’s to be punished.",[202,1191,1192],{},"Cry me a river.",[202,1194,1195],{},"The sins of your father",[202,1197,1198],{},"won’t wash with blood.",[202,1200,292],{},[202,1202,1203],{},"Go on then,",[202,1205,1206],{},"What a life.",[202,1208,1209],{},"You’re no victim.",[202,1211,1212],{},"You’re holding the knife.",[202,1214,207],{},[197,1216,1218],{"id":1217},"scorpio-gemini-leo",[272,1219,1220],{},"Scorpio, Gemini, Leo",[202,1222,1223],{},"We are travelers,",[202,1225,1226],{},"You and I,",[202,1228,1229],{},"And for a while",[202,1231,1232],{},"We walked the same road.",[202,1234,292],{},[202,1236,1237],{},"We were doomed,",[202,1239,1240],{},"Always to part,",[202,1242,1243],{},"And we are doomed still,",[202,1245,1246],{},"By weakness of flesh.",[202,1248,292],{},[202,1250,1251],{},"Find me lacking,",[202,1253,1254],{},"I’m not her,",[202,1256,1257],{},"I never could be.",[202,1259,1260],{},"Detached, reflective, prevaricatory.",[202,1262,292],{},[202,1264,1265],{},"Strike at me,",[202,1267,1268],{},"Make me hurt,",[202,1270,1271],{},"Make me bleed,",[202,1273,1274],{},"Again! Again!",[202,1276,292],{},[202,1278,1279],{},"But you who have no respect,",[202,1281,1282],{},"For sacred ground you defile.",[202,1284,1285],{},"You who walk into hallowed halls",[202,1287,1288],{},"Of another woman’s ruin.",[202,1290,292],{},[202,1292,1293],{},"I’m no better,",[202,1295,1296],{},"Ignored the wound in your side.",[202,1298,1299],{},"I saw the blood, fresh and gushing,",[202,1301,1302],{},"Said it wasn’t my place.",[202,1304,292],{},[202,1306,1307],{},"Still we lingered,",[202,1309,1310],{},"Could we have been sisters?",[202,1312,1313],{},"Told me we might never end;",[202,1315,1316],{},"I can spot a liar.",[202,1318,292],{},[202,1320,1321],{},"Gone the first chance you got,",[202,1323,1324],{},"Tender moments dissolved in rain.",[202,1326,1327],{},"My fault or not,",[202,1329,1330],{},"Does it matter?",[202,1332,292],{},[202,1334,1335],{},"You watch from your distance.",[202,1337,1338],{},"Are you audience, spectator?",[202,1340,1341],{},"Are you guardian, protector?",[202,1343,1344],{},"Are you judgment, damnation?",[202,1346,292],{},[202,1348,1349],{},"I feel you still,",[202,1351,1352],{},"In the glow of moonlight,",[202,1354,1355],{},"In songs curated,",[202,1357,1358],{},"In the tales I saw in your eyes.",[202,1360,292],{},[202,1362,1363],{},"Come and sit by the fire,",[202,1365,1366],{},"Tell me your stories.",[202,1368,1369],{},"The night is young,",[202,1371,1372],{},"And for now so are we.",[202,1374,292],{},[202,1376,1377],{},"Told you to find me if you need me,",[202,1379,1380],{},"Promised I’d help.",[202,1382,1383],{},"Look me up and find I’m a liar,",[202,1385,1386],{},"I have nothing for you.",[202,1388,207],{},[197,1390,1392],{"id":1391},"in-lavender-dreams",[272,1393,1394],{},"In Lavender Dreams",[202,1396,1397],{},"No heart like yours,",[202,1399,1400],{},"None could ever compare.",[202,1402,1403],{},"Zealous faith of the reverent chosen.",[202,1405,1406],{},"Yearning for the promise of what will be.",[202,1408,1409],{},"A bird so used to bleeding,",[202,1411,1412],{},"Pouring out herself.",[202,1414,1415],{},"Joined by hound,",[202,1417,1418],{},"Ever faithful companion.",[202,1420,1421],{},"Should we linger a while longer,",[202,1423,1424],{},"See the shapes we take,",[202,1426,1427],{},"The lives we live,",[202,1429,1430],{},"The heart we share.",[202,1432,1433],{},"The traveler walks sandy dunes,",[202,1435,1436],{},"Thirsty and desperate,",[202,1438,1439],{},"drops to a crawl,",[202,1441,1442],{},"Spared by the oasis she finds.",[202,1444,1445],{},"The relief you give so freely.",[202,1447,1448],{},"So guard this place,",[202,1450,1451],{},"Steady shield and raise spear.",[202,1453,1454],{},"Never yield this gift,",[202,1456,1457],{},"The love you have given me.",[202,1459,207],{},[197,1461,1463],{"id":1462},"lurasidone-80mg-daily",[272,1464,1465],{},"Lurasidone, 80mg Daily",[202,1467,1468],{},"Behold, the great leviathan rises!",[202,1470,1471],{},"Its deep slumber halted,",[202,1473,1474],{},"To ravage vessels sailor-laden,",[202,1476,1477],{},"That the shores may run red.",[202,1479,1480],{},"A beast massive, mad, and manic,",[202,1482,1483],{},"The mother of monsters sings a song,",[202,1485,1486],{},"In tongue older than empires,",[202,1488,1489],{},"Crazed truths that ring through eternity.",[202,1491,1492],{},"Cast aside ploughshare, sword, fishhook,",[202,1494,1495],{},"The might of the sea will have its way.",[202,1497,1498],{},"Think not of love, mercy, or grace,",[202,1500,1501],{},"The serpent will obey only Yahweh.",[202,1503,292],{},[202,1505,1506],{},"The ancient demon once bound,",[202,1508,1509],{},"By chemical shackles,",[202,1511,1512],{},"Freed to wound the soul of woman,",[202,1514,1515],{},"To thrash and claw at mental walls.",[202,1517,1518],{},"Starved and thirsty,",[202,1520,1521],{},"It will have its fill,",[202,1523,1524],{},"And it will destroy all you hold dear,",[202,1526,1527],{},"But it will be with you still.",[202,1529,1530],{},"That companion never quite free,",[202,1532,1533],{},"It waited for so long, it missed you,",[202,1535,1536],{},"A mind to bend, to direct toward glory,",[202,1538,1539],{},"Is it so wrong to give in?",[202,1541,207],{},[197,1543,1545],{"id":1544},"notes-on-nullification-procedure-1331",[272,1546,1547],{},"Notes on Nullification Procedure 1331",[202,1549,1550],{},"Who are you",[202,1552,1553],{},"When it all falls away?",[202,1555,1556],{},"Monks would kill for this tranquility,",[202,1558,1559],{},"But you don’t much feel a thing.",[202,1561,1562],{},"Music bleeds emotion,",[202,1564,1565],{},"All true, all true.",[202,1567,1568],{},"Sealed in the depths",[202,1570,1571],{},"Never to rise.",[202,1573,1574],{},"Will they ever see?",[202,1576,1577],{},"Will you?",[202,1579,1580],{},"Spark up,",[202,1582,1583],{},"Inhale too sharply,",[202,1585,1586],{},"Cough until you choke.",[202,1588,1589],{},"Laugh,",[202,1591,1592],{},"Because it’s all you can do.",[202,1594,1595],{},"Starved crops begging for the rain,",[202,1597,1598],{},"For when you finally cry",[202,1600,207],{},[197,1602,1604],{"id":1603},"abhor-the-parasite",[272,1605,1606],{},"Abhor the Parasite",[202,1608,1609],{},"Limbs the roots of a vile weed.",[202,1611,1612],{},"Body bulbous and deformed.",[202,1614,1615],{},"Your voice raised from cursed flesh,",[202,1617,1618],{},"Soft, sweet, mismatched.",[202,1620,1621],{},"You’ll never be a woman looking like that.",[202,1623,1624],{},"Cry, seethe, joke, deflect,",[202,1626,1627],{},"They see what you are anyway.",[202,1629,1630],{},"Family says they love you,",[202,1632,1633],{},"Spit out the lie.",[202,1635,1636],{},"They love him, the thing that strangled you,",[202,1638,1639],{},"So you pushed him down, made to drown.",[202,1641,1642],{},"You had to, you had to.",[202,1644,1645],{},"You thought no one would blame you,",[202,1647,1648],{},"They mourned him and cursed your joy.",[202,1650,1651],{},"Get away, never look back.",[202,1653,1654],{},"Find escape in anything you can.",[202,1656,1657],{},"Smoke another cigarette and cough,",[202,1659,1660],{},"not your cough, but his.",[202,1662,1663],{},"Look in the mirror,",[202,1665,1666],{},"Not your face, but his.",[202,1668,1669],{},"Freak out,",[202,1671,1672],{},"Scratch your arms until they bleed,",[202,1674,1675],{},"Not your blood, but his.",[202,1677,1678],{},"You’re not your own,",[202,1680,1681],{},"This vessel isn’t big enough for two.",[202,1683,1684],{},"Try again to drown the parasite,",[202,1686,1687],{},"But is it him or you?",[202,1689,207],{},[197,1691,1693],{"id":1692},"hail-haruspex",[272,1694,1695],{},"Hail, Haruspex",[202,1697,1698],{},"Scatter the bones,",[202,1700,1701],{},"Cast the entrails.",[202,1703,1704],{},"The blood sings",[202,1706,1707],{},"For the listening.",[202,1709,292],{},[202,1711,1712],{},"Speak true, speak power.",[202,1714,1715],{},"Glyphs conjured on flesh,",[202,1717,1718],{},"Seal fates and guide souls",[202,1720,1721],{},"Believers in your sight.",[202,1723,292],{},[202,1725,1726],{},"They don’t know,",[202,1728,1729],{},"You drew it from a dream.",[202,1731,1732],{},"Spun it with the thread,",[202,1734,1735],{},"Made it real.",[202,1737,292],{},[202,1739,1740],{},"Clutch the gutting knife,",[202,1742,1743],{},"It’s dirty work.",[202,1745,1746],{},"But you’re no watcher.",[202,1748,1749],{},"Vision cast upon the world.",[202,1751,292],{},[202,1753,1754],{},"Pay no mind,",[202,1756,1757],{},"To ichorous choirs.",[202,1759,1760],{},"You know best,",[202,1762,1763],{},"You have to.",[202,1765,292],{},[202,1767,1768],{},"To be wrong,",[202,1770,1771],{},"How could that be?",[202,1773,1774],{},"Unmoored, unshackled,",[202,1776,1777],{},"Adrift in the cosmic sea.",[202,1779,292],{},[202,1781,1782],{},"No, your purpose clear.",[202,1784,1785],{},"Your foremothers led you here.",[202,1787,1788],{},"Cast another fortune,",[202,1790,1791],{},"See only a reflection.",[202,1793,207],{},[197,1795,1797],{"id":1796},"the-gnawing",[272,1798,1799],{},"The Gnawing",[202,1801,1802],{},"Call me a liar,",[202,1804,1805],{},"Fraud,",[202,1807,1808],{},"Coward,",[202,1810,1811],{},"Loser,",[202,1813,1814],{},"Psycho.",[202,1816,292],{},[202,1818,1819],{},"All true",[202,1821,1822],{},"Would speak of you.",[202,1824,1825],{},"But how does the tide",[202,1827,1828],{},"Dream to describe the sea?",[202,1830,292],{},[202,1832,1833],{},"Such little true beauty left,",[202,1835,1836],{},"In such a bleak place.",[202,1838,1839],{},"It shone from you,",[202,1841,1842],{},"And I hid my face.",[202,1844,292],{},[202,1846,1847],{},"A tenfold thousand of hours,",[202,1849,1850],{},"Would not be enough,",[202,1852,1853],{},"To bask in the great depths",[202,1855,1856],{},"Of the oceans in your mind.",[202,1858,292],{},[202,1860,1861],{},"Took my hand, took my face,",[202,1863,1864],{},"Saw the hurt,",[202,1866,1867],{},"Said I must be tired,",[202,1869,1870],{},"Asked if I’d like to rest.",[202,1872,292],{},[202,1874,1875],{},"And lion lay with lamb",[202,1877,1878],{},"A love given freely",[202,1880,1881],{},"Unburdened by the cost of tears",[202,1883,1884],{},"And tax of pain.",[202,1886,292],{},[202,1888,1889],{},"That great many promises I swore",[202,1891,1892],{},"To be true to you.",[202,1894,1895],{},"Turned into a millstone",[202,1897,1898],{},"Wrapped around my neck.",[202,1900,292],{},[202,1902,1903],{},"To drown an oathbreaking whore.",[202,1905,292],{},[202,1907,1908],{},"Did you see it coming?",[202,1910,1911],{},"Signs in soul sickness made apparent.",[202,1913,1914],{},"Did you think this would be different?",[202,1916,1917],{},"Bless me with unworthy trust.",[202,1919,292],{},[202,1921,1922],{},"When my heart wandered,",[202,1924,1925],{},"It wasn’t you, rather your love",[202,1927,1928],{},"Squandered on a shard,",[202,1930,1931],{},"this sharp and brittle thing.",[202,1933,292],{},[202,1935,1936],{},"Didn’t go easy,",[202,1938,1939],{},"The stubborn push and pull.",[202,1941,1942],{},"Find another way,",[202,1944,1945],{},"This time it will work.",[202,1947,292],{},[202,1949,1950],{},"It has to.",[202,1952,292],{},[202,1954,1955],{},"It doesn’t, it won’t",[202,1957,1958],{},"Not your fault, mine.",[202,1960,1961],{},"Wished to be my everything,",[202,1963,1964],{},"But I’m still hungry.",[202,1966,292],{},[202,1968,1969],{},"The family dog howls,",[202,1971,1972],{},"Maggots infest old wounds.",[202,1974,1975],{},"Grab the rifle and a shell",[202,1977,1978],{},"We’ll do what we need to do.",[202,1980,207],{},[197,1982,1984],{"id":1983},"but-seriously-fuck-you",[272,1985,1986],{},"But Seriously, Fuck You",[202,1988,1989],{},"Hit me like a freight train,",[202,1991,1992],{},"pretend it never happened.",[202,1994,1995],{},"Sigh it out or swallow it,",[202,1997,1998],{},"Gotta take it just the same.",[202,2000,2001],{},"The things we choose set out to sea",[202,2003,2004],{},"unfathomable waters of contingency.",[202,2006,292],{},[202,2008,2009],{},"Hold me in contempt",[202,2011,2012],{},"Of your infernal court.",[202,2014,2015],{},"Hold me like I’m poisonous,",[202,2017,2018],{},"Or keep my leash short.",[202,2020,2021],{},"At least you held me–",[202,2023,2024],{},"That’s enough, right?",[202,2026,292],{},[202,2028,2029],{},"Bring me your triumphs,",[202,2031,2032],{},"Set at my feet your woes.",[202,2034,2035],{},"I’ll howl your praises to the moon,",[202,2037,2038],{},"Because I’m your broken dog.",[202,2040,2041],{},"You never need ask",[202,2043,2044],{},"for that which I give freely.",[202,2046,292],{},[202,2048,2049],{},"So wash me with your hate,",[202,2051,2052],{},"carpet bomb with sweetness.",[202,2054,2055],{},"Mixed together icy hot",[202,2057,2058],{},"An agonizing sensation,",[202,2060,2061],{},"That would count as torture–",[202,2063,2064],{},"You should sell it to the CIA.",[202,2066,292],{},[202,2068,2069],{},"But I’m no victim,",[202,2071,2072],{},"Nor given to that weakness.",[202,2074,2075],{},"I chose this.",[202,2077,2078],{},"I choose this.",[202,2080,2081],{},"Call me worm,",[202,2083,2084],{},"Call me kindred.",[202,2086,292],{},[202,2088,2089],{},"This is a game,",[202,2091,2092],{},"And we’re both keeping score.",[202,2094,2095],{},"So forgive my psychosis",[202,2097,2098],{},"And I’ll absolve your psychopathy.",[202,2100,2101],{},"The sickness we share",[202,2103,2104],{},"Deep and cold as a cave.",[202,2106,292],{},[202,2108,2109],{},"Find your place,",[202,2111,2112],{},"In city lights or the shore,",[202,2114,2115],{},"I’ll remain here a while longer.",[202,2117,2118],{},"But watch out,",[202,2120,2121],{},"I’ve been spending time in the forest,",[202,2123,2124],{},"And I told the trees what you did.",[202,2126,207],{},[197,2128,2130],{"id":2129},"always-more-blood",[272,2131,2132],{},"Always More Blood",[202,2134,2135],{},"And lo that great temple has fallen!",[202,2137,2138],{},"Built not for a god but for",[202,2140,2141],{},"The shape of two.",[202,2143,2144],{},"It has stood before,",[202,2146,2147],{},"And it will stand again.",[202,2149,2150],{},"When tenderhearted pilgrims find refuge.",[202,2152,2153],{},"Not for love,",[202,2155,2156],{},"No, no, no,",[202,2158,2159],{},"But for kindred true.",[202,2161,2162],{},"Let another wanderer in,",[202,2164,2165],{},"Give them rest, give them care,",[202,2167,2168],{},"Moments shared, tragedy they precede.",[202,2170,2171],{},"Did you think it would be different,",[202,2173,2174],{},"Or did you pretend too?",[202,2176,2177],{},"Lies we tell to justify want,",[202,2179,2180],{},"Give unto this place its due.",[202,2182,2183],{},"Fed by sweetness and sorrow alike,",[202,2185,2186],{},"Their tales scrawled on walls to read.",[202,2188,2189],{},"There the High Priestess waits,",[202,2191,2192],{},"The next one comes in need.",[202,2194,2195],{},"She will always have more bones to break,",[202,2197,2198],{},"The white altar will remain sated,",[202,2200,2201],{},"She will always have more blood to bleed.",[202,2203,207],{},[197,2205,2207],{"id":2206},"title-track",[272,2208,2209],{},"Title Track",[202,2211,2212],{},"Another crack,",[202,2214,2215],{},"The foundation strains.",[202,2217,2218],{},"Probably fine.",[202,2220,2221],{},"Words make the caulk",[202,2223,2224],{},"That seals it.",[202,2226,2227],{},"Good enough for now.",[202,2229,292],{},[202,2231,2232],{},"A whole life spent running,",[202,2234,2235],{},"Silver tongues buy time,",[202,2237,2238],{},"But there’s no end in sight.",[202,2240,292],{},[202,2242,2243],{},"Words.",[202,2245,2246],{},"Get troublesome girls hit.",[202,2248,2249],{},[2250,2251,2252],"em",{},"Stay away from me.",[202,2254,292],{},[202,2256,2243],{},[202,2258,2259],{},"Met with a read receipt.",[202,2261,2262],{},[2250,2263,2264],{},"What did I do?",[202,2266,292],{},[202,2268,2243],{},[202,2270,2271],{},"Justify the narrative.",[202,2273,2274],{},[2250,2275,2276],{},"Keep them entertained.",[202,2278,292],{},[202,2280,2243],{},[202,2282,2283],{},"Build the glass house",[202,2285,2286],{},"That lets them all see.",[202,2288,2289],{},"Find the right combination,",[202,2291,2292],{},"Make them understand.",[202,2294,2295],{},"They have to.",[202,2297,2298],{},"Alternatives unfathomable.",[202,2300,292],{},[202,2302,2303],{},"Crystal shards break,",[202,2305,2306],{},"Pierce skin,",[202,2308,2309],{},"Screams heard down the block.",[202,2311,2312],{},"A prison designed by captive,",[202,2314,2315],{},"Could never be happy anywhere.",[202,2317,292],{},[202,2319,2320],{},"In time,",[202,2322,2323],{},"She resembles her transparent tomb.",[202,2325,2326],{},"Sharp, hard, brittle.",[202,2328,2329],{},"A thorny thing.",[202,2331,2332],{},"Yet propelled by faith,",[202,2334,2335],{},"One day this will be over.",[202,2337,207],{},[197,2339,2341],{"id":2340},"flightless",[272,2342,2343],{},"Flightless",[202,2345,2346],{},"I killed a bird today.",[202,2348,2349],{},"Didn’t mean to.",[202,2351,2352],{},"Doesn’t matter.",[202,2354,2355],{},"Dead the same.",[202,2357,2358],{},"What foul mockery,",[202,2360,2361],{},"To claim beak and wing.",[202,2363,2364],{},"False, grounded songbird,",[202,2366,2367],{},"Who prowls as Cain.",[202,2369,2370],{},"It stood on asphalt,",[202,2372,2373],{},"Tall and crying.",[202,2375,2376],{},"Wounded, stuck, trapped.",[202,2378,2379],{},"Couldn’t escape.",[202,2381,2382],{},"It called for mother,",[202,2384,2385],{},"It called for God,",[202,2387,2388],{},"It called for me,",[202,2390,2391],{},"None to hear.",[202,2393,2394],{},"To be the same,",[202,2396,2397],{},"Hearts belonging to the skies.",[202,2399,2400],{},"Seek a friend,",[202,2402,2403],{},"find an uncaring steel beast,",[202,2405,2406],{},"And the car I was driving.",[202,2408,2409],{},"Betrayer,",[202,2411,2412],{},"Brutus,",[202,2414,2415],{},"Calls myself your kin,",[202,2417,2418],{},"But just the spawn of Judas.",[202,2420,2421],{},"Seek remorse,",[202,2423,2424],{},"Seek anguish,",[202,2426,2427],{},"Seek conscience,",[202,2429,2430],{},"Find none left.",[202,2432,2433],{},"Because I’m not sorry,",[202,2435,2436],{},"Can’t feel much of anything.",[202,2438,2439],{},"But you’re gone.",[202,2441,2442],{},"And that’s my fault.",[202,2444,2445],{},"Life continues, one less.",[202,2447,2448],{},"Another ghost joins the choir,",[202,2450,2451],{},"But the birds remember.",[202,2453,2454],{},"The blood cries out,",[202,2456,2457],{},"The ink that forms words;",[202,2459,2460],{},"Each page a confession.",{"title":266,"searchDepth":2462,"depth":2462,"links":2463},2,[2464,2465,2466,2467,2468,2469,2470,2471,2472,2473,2474,2475,2476,2477,2478,2479,2480,2481,2482,2483,2484,2485],{"id":199,"depth":2462,"text":200},{"id":270,"depth":2462,"text":274},{"id":352,"depth":2462,"text":355},{"id":441,"depth":2462,"text":444},{"id":587,"depth":2462,"text":590},{"id":658,"depth":2462,"text":661},{"id":748,"depth":2462,"text":751},{"id":792,"depth":2462,"text":795},{"id":918,"depth":2462,"text":921},{"id":1038,"depth":2462,"text":1041},{"id":1121,"depth":2462,"text":1124},{"id":1217,"depth":2462,"text":1220},{"id":1391,"depth":2462,"text":1394},{"id":1462,"depth":2462,"text":1465},{"id":1544,"depth":2462,"text":1547},{"id":1603,"depth":2462,"text":1606},{"id":1692,"depth":2462,"text":1695},{"id":1796,"depth":2462,"text":1799},{"id":1983,"depth":2462,"text":1986},{"id":2129,"depth":2462,"text":2132},{"id":2206,"depth":2462,"text":2209},{"id":2340,"depth":2462,"text":2343},"2024-09-28T00:00:00.000Z","md",false,{},true,"/poetry/glass-walls-briarheart",{"title":186,"description":200},"poetry/glass-walls-briarheart",[2495,2496,2497,266],"borderline personality","poetry","bird","XQLuD2ZvjNmWGDhRx2HXGPjFKOGcbhQk_dMozdmcqoo",1761794491012]