620,1623,1626,1629,1631,1634,1637,1640,1643,1645,1648,1651,1654,1657,1659,1665,1668,1671,1674,1677,1680,1682,1685,1688,1691,1694,1696,1699,1702,1705,1708,1710,1713,1716,1719,1722,1724,1727,1730,1733,1736,1738,1741,1744,1747,1750,1752,1755,1758,1761,1764,1766,1769,1771,1774,1777,1780,1783,1785,1788,1791,1794,1797,1799,1802,1805,1808,1811,1813,1816,1818,1821,1824,1827,1830,1832,1835,1838,1841,1844,1846,1852,1855,1858,1861,1864,1867,1870,1872,1875,1878,1881,1884,1887,1890,1892,1895,1898,1901,1904,1907,1910,1912,1915,1918,1921,1924,1927,1930,1932,1935,1938,1941,1944,1947,1950,1952,1955,1958,1961,1964,1967,1970,1972,1975,1978,1981,1984,1987,1990,1992,1998,2001,2004,2007,2010,2013,2016,2019,2022,2025,2028,2031,2034,2037,2040,2043,2046,2049,2052,2055,2058,2061,2064,2067,2069,2075,2078,2081,2084,2087,2090,2093,2095,2098,2101,2104,2106,2109,2112,2118,2120,2122,2125,2130,2132,2134,2137,2142,2144,2146,2149,2152,2155,2158,2161,2164,2166,2169,2172,2175,2178,2181,2183,2186,2189,2192,2195,2198,2201,2203,2209,2212,2215,2218,2221,2224,2227,2230,2233,2236,2239,2242,2245,2248,2251,2254,2257,2260,2263,2266,2269,2272,2275,2278,2281,2284,2287,2290,2293,2296,2299,2302,2305,2308,2311,2314,2317,2320,2323],[59,60,53],"h1",{"id":61},"glass-walls-briarhearts",[63,64,66],"h2",{"id":65},"a-poetry-collection","A poetry collection.",[68,69,70],"p",{},"R. Val",[68,72,73],{},"— — — — —",[68,75,76],{},"An introduction is a call to defense,",[68,78,79],{},"Who am I? Why write this down?",[68,81,82],{},"Why is this worth your time?",[68,84,85],{},"I’m not the one who can answer that.",[68,87,88],{},"In the following text, I will attempt to communicate something.",[68,90,91],{},"The shape and tenor is unknown to me,",[68,93,94],{},"As it is to you.",[68,96,97],{},"But It is within me and I need it to not be.",[68,99,100],{},"It will take the form of deception.",[68,102,103],{},"Not lies, no.",[68,105,106],{},"Refractions,",[68,108,109],{},"Details cast through prisms and reshaped.",[68,111,112],{},"You will see what you will.",[68,114,115],{},"You, me, some third party.",[68,117,118],{},"It will be true enough.",[68,120,121],{},"Humans are creatures of narrative.",[68,123,73],{},[68,125,126],{},"Press enter or click to view image in full size",[68,128,129],{},[130,131],"img",{"alt":10,"src":132},"https://miro.medium.com/v2/resize:fit:1050/1*-9mWwB3PnDg3iJ5gppfOSw@2x.jpeg",[63,134,136],{"id":135},"_1979-the-last-age",[137,138,139],"strong",{},"1979, The Last Age",[68,141,142],{},"In murky mornings you sing",[68,144,145],{},"The song of those who came before.",[68,147,148],{},"By marsh, river, and sea,",[68,150,151],{},"Eons long endured to put you",[68,153,154],{},"In your appointed place.",[68,156,157],{},"~",[68,159,160],{},"So many once sang,",[68,162,163],{},"Kindred steadfast and true.",[68,165,166],{},"Less now, soon none.",[68,168,169],{},"Just you,",[68,171,172],{},"And the tune that ends all things.",[68,174,157],{},[68,176,177],{},"Do you sing for another?",[68,179,180],{},"One like you, dusky and mottled.",[68,182,183],{},"Do you sing for their ghosts?",[68,185,186],{},"That you might tear the veil.",[68,188,189],{},"Do you sing because it is you?",[68,191,192],{},"And that is all you know how to do.",[68,194,157],{},[68,196,197],{},"A last cry to breach expanse so vast.",[68,199,200],{},"You carry them on your wings.",[68,202,203],{},"Your brothers did too,",[68,205,206],{},"Gone now and soon you.",[68,208,209],{},"But let the coasts know,",[68,211,212],{},"Of the sparrows that were once here.",[68,214,73],{},[63,216,218],{"id":217},"to-the-unknown-assailant-currently-residing-in-my-bedroom",[137,219,220],{},"To the Unknown Assailant Currently Residing in my Bedroom",[68,222,223],{},"What did you feel,",[68,225,226],{},"That terrible day?",[68,228,229],{},"When you found yourself",[68,231,232],{},"Trapped in half washed locks?",[68,234,235],{},"The forest of some giant,",[68,237,238],{},"Careless and distant.",[68,240,241],{},"Thrash and pull,",[68,243,244],{},"anything to break free.",[68,246,247],{},"You cried for help,",[68,249,250],{},"For kin or god,",[68,252,253],{},"None heard you.",[68,255,256],{},"I didn’t help you,",[68,258,259],{},"I didn’t know,",[68,261,262],{},"I didn’t understand,",[68,264,265],{},"I’m sorry.",[68,267,268],{},"Would ask what you think,",[68,270,271],{},"But you don’t think, do you?",[68,273,274],{},"A life of hunger, rage, and fear.",[68,276,277],{},"It’s still a life.",[68,279,280],{},"Must’ve been deranged and miserable,",[68,282,283],{},"When I pulled you out.",[68,285,286],{},"Never even saw more than a glimpse.",[68,288,289],{},"Black carapace,",[68,291,292],{},"Soft and warm.",[68,294,295],{},"You clung to my hand so tight,",[68,297,298],{},"When you stung me.",[68,300,301],{},"Please leave.",[68,303,73],{},[63,305,307],{"id":306},"in-memory-of-private-riley-jacobs-9871011",[137,308,309],{},"In Memory of Private Riley Jacobs, 987–1011",[68,311,312],{},"“Fearfully and wonderfully made.”",[68,314,315],{},"True for some,",[68,317,318],{},"Not you.",[68,320,321],{},"Doomed as soon as you walk on screen.",[68,323,157],{},[68,325,326],{},"The shots start,",[68,328,329],{},"You’re already gone.",[68,331,332],{},"Story cut short,",[68,334,335],{},"That others would be told.",[68,337,157],{},[68,339,340],{},"No way out,",[68,342,343],{},"No path forward.",[68,345,346],{},"A prop in the dance,",[68,348,349],{},"Of rook and lion.",[68,351,157],{},[68,353,354],{},"Did you know?",[68,356,357],{},"Scared to hell.",[68,359,360],{},"Did it hurt?",[68,362,363],{},"The heat in your side.",[68,365,157],{},[68,367,368],{},"Did your mother dream for you?",[68,370,371],{},"A hero of old,",[68,373,374],{},"Dashing and bold,",[68,376,377],{},"Draped in violet.",[68,379,157],{},[68,381,382],{},"A whole life lived,",[68,384,385],{},"A whole life wasted,",[68,387,388],{},"On a connecting paragraph,",[68,390,391],{},"And a grim fucking punchline.",[68,393,157],{},[68,395,396],{},"Your path unfolded,",[68,398,399],{},"All roads lead to",[68,401,402],{},"Your appointed place.",[68,404,405],{},"The boots of your betters.",[68,407,157],{},[68,409,410],{},"Ask me why,",[68,412,413],{},"Beg that this fate",[68,415,416],{},"may pass from you.",[68,418,419],{},"Another chance to be great.",[68,421,157],{},[68,423,424],{},"Find no mercy,",[68,426,427],{},"For I am the Lord your God.",[68,429,430],{},"Might justifies itself,",[68,432,433],{},"And is an architect of ruin.",[68,435,157],{},[68,437,438],{},"But let someone weep for the forgotten,",[68,440,441],{},"For the spaces filled in",[68,443,444],{},"With bright eyed innocents,",[68,446,447],{},"Cut down in the afterthought.",[68,449,73],{},[63,451,453],{"id":452},"lagoonborn",[137,454,455],{},"Lagoonborn",[68,457,458],{},"Your love has no price,",[68,460,461],{},"Not the blood cost of before.",[68,463,464],{},"Celebrated me,",[68,466,467],{},"my demented dance.",[68,469,470],{},"Tell me dear,",[68,472,473],{},"I may wade in your waters a while longer.",[68,475,476],{},"Make me believe,",[68,478,479],{},"Make me wish to see,",[68,481,482],{},"The world through amber eyes.",[68,484,485],{},"A world of hope and beauty,",[68,487,488],{},"that pales in your wake,",[68,490,491],{},"That I did not know existed before you.",[68,493,494],{},"Heavens bless those who bless you,",[68,496,497],{},"Hells take those who do you harm.",[68,499,500],{},"Guide my hands,",[68,502,503],{},"May I be half the woman",[68,505,506],{},"You always deserved.",[68,508,509],{},"This road will end, in parting or the grave,",[68,511,512],{},"As all roads do.",[68,514,515],{},"But for as long as I am able,",[68,517,518],{},"I wish to be yours true.",[68,520,73],{},[63,522,524],{"id":523},"draconic-11",[137,525,526],{},"Draconic 11",[68,528,529],{},"So lick your wounds,",[68,531,532],{},"And I’ll keep watch.",[68,534,535],{},"Tell me your stories,",[68,537,538],{},"Pretend it’s the first time.",[68,540,157],{},[68,542,543],{},"Magnets of like charge repulsed,",[68,545,546],{},"Yet we are the same.",[68,548,549],{},"Players of the dark game.",[68,551,552],{},"Practicers of sanguine rituals.",[68,554,157],{},[68,556,557],{},"Never to align,",[68,559,560],{},"Sworn to destroy,",[68,562,563],{},"That which each other holds dear.",[68,565,566],{},"But what do we really believe in?",[68,568,157],{},[68,570,571],{},"Brought together by two choices,",[68,573,574],{},"Sustained by dozens after.",[68,576,577],{},"A friendship,",[68,579,580],{},"An imploding submarine.",[68,582,157],{},[68,584,585],{},"So go around again,",[68,587,588],{},"One more time.",[68,590,591],{},"We could get it right.",[68,593,594],{},"Just a dream, not always bad.",[68,596,157],{},[68,598,599],{},"So stay away,",[68,601,602],{},"Wish you well, curse me to hell.",[68,604,605],{},"When the world grovels at your feet,",[68,607,608],{},"I’ll be a true believer.",[68,610,73],{},[63,612,614],{"id":613},"the-watcher",[137,615,616],{},"The Watcher",[68,618,619],{},"Another day, what should be the aftermath.",[68,621,622],{},"A number on a screen tells me you’re still here.",[68,624,625],{},"Still here, above and beyond, out of reach.",[68,627,628],{},"I should feel safe, my guardian angel, but you’re no protector.",[68,630,631],{},"Your hate oozes down my spine, sickening and foul.",[68,633,634],{},"“Am I as hideous as you say?”",[68,636,637],{},"I type the thought, close the screen, and move on.",[68,639,640],{},"You’ll be there when I’m back, you’ll always be there.",[68,642,643],{},"What did I do to deserve this curse?",[68,645,646],{},"What did you do to be bound in kind?",[68,648,649],{},"That whenever I act, you watch.",[68,651,652],{},"Still here, still here.",[68,654,73],{},[63,656,658],{"id":657},"_711-927-pm",[137,659,660],{},"7–11, 9:27 PM",[68,662,663],{},"I fear you,",[68,665,666],{},"stranger in my way.",[68,668,669],{},"Made to share moment brief,",[68,671,672],{},"To share this space too small.",[68,674,157],{},[68,676,663],{},[68,678,679],{},"Eyes I cannot read.",[68,681,682],{},"A smile hollow,",[68,684,685],{},"Is that a smile?",[68,687,157],{},[68,689,690],{},"I hate you,",[68,692,693],{},"Enemy, alien, unknown.",[68,695,696],{},"Seed of Esau,",[68,698,699],{},"Born of adversity.",[68,701,157],{},[68,703,704],{},"I love you,",[68,706,707],{},"Fellow wandering soul.",[68,709,710],{},"Human, same as me.",[68,712,713],{},"More alike than not.",[68,715,716],{},"\u003C",[68,718,719],{},"I weep for you,",[68,721,722],{},"Child of the Last Age.",[68,724,725],{},"Swallowed by that cold maw,",[68,727,728],{},"Shoulder to shoulder.",[68,730,157],{},[68,732,733],{},"I hope for you,",[68,735,736],{},"Your joys and triumphs.",[68,738,739],{},"That you bring beauty,",[68,741,742],{},"Into a world grown dark.",[68,744,157],{},[68,746,747],{},"I fear me,",[68,749,750],{},"What you must see.",[68,752,753],{},"Half mad and scourged,",[68,755,756],{},"Less than once was.",[68,758,157],{},[68,760,663],{},[68,762,763],{},"Thoughts a mystery.",[68,765,766],{},"Will you kill me?",[68,768,769],{},"Would that be so bad?",[68,771,157],{},[68,773,774],{},"I fear you.",[68,776,157],{},[68,778,774],{},[68,780,73],{},[63,782,784],{"id":783},"momentum",[137,785,786],{},"Momentum",[68,788,789],{},"Keep going.",[68,791,792],{},"Step 1, Step 2,",[68,794,795],{},"Step 3, Step 4.",[68,797,798],{},"Running now,",[68,800,801],{},"Lines upon lines.",[68,803,804],{},"What are you trying to get out?",[68,806,807],{},"Snag on the thought,",[68,809,810],{},"Crash and tumble.",[68,812,813],{},"Lay there in the dark.",[68,815,816],{},"A piece is as incomplete as you.",[68,818,819],{},"Try again,",[68,821,822],{},"Step 1.",[68,824,825],{},"No,",[68,827,828],{},"It doesn’t feel the same.",[68,830,819],{},[68,832,792],{},[68,834,835],{},"You need this to hurt,",[68,837,838],{},"How else will you feel alive?",[68,840,841],{},"Step 1,",[68,843,844],{},"You should call her.",[68,846,841],{},[68,848,849],{},"The words flowed through you then.",[68,851,841],{},[68,853,854],{},"You’re so sober.",[68,856,841],{},[68,858,859],{},"The bar is just down the street.",[68,861,841],{},[68,863,864],{},"Another delay, another thing wrong.",[68,866,841],{},[68,868,869],{},"Maybe the problem is you.",[68,871,872],{},"Breathe.",[68,874,875],{},"Breathe again,",[68,877,878],{},"Become an instrument.",[68,880,881],{},"Fingers at the keys.",[68,883,884],{},"Type,",[68,886,841],{},[68,888,889],{},"Step 2,",[68,891,892],{},"Step 3,",[68,894,895],{},"Running again.",[68,897,898],{},"Never stop.",[68,900,73],{},[63,902,904],{"id":903},"poetry-wont-fix-this",[137,905,906],{},"Poetry Won’t Fix This",[68,908,909],{},"Another skin,",[68,911,912],{},"Freshly shorn,",[68,914,915],{},"Newly worn.",[68,917,918],{},"Do this so easy,",[68,920,921],{},"Call a stranger’s face your own,",[68,923,924],{},"Never at home when you’re alone.",[68,926,927],{},"Play the part,",[68,929,930],{},"Actor,",[68,932,933],{},"Impostor,",[68,935,936],{},"Changeling.",[68,938,939],{},"Another way to escape yourself.",[68,941,942],{},"Another hat,",[68,944,945],{},"A costume change,",[68,947,948],{},"It won’t save you.",[68,950,951],{},"The rot’s still there,",[68,953,954],{},"Festering in bone.",[68,956,957],{},"You already know,",[68,959,960],{},"Do it for the art,",[68,962,963],{},"Play, pretend, perfect.",[68,965,966],{},"Getting so good at this,",[68,968,969],{},"Find another way.",[68,971,972],{},"Repeat, refresh",[68,974,975],{},"An answer for a time.",[68,977,978],{},"Another narrative,",[68,980,981],{},"To justify the void.",[68,983,73],{},[63,985,987],{"id":986},"the-last-verse-of-runner",[137,988,989],{},"The Last Verse of Runner",[68,991,992],{},"Sticking your nose in bear traps",[68,994,995],{},"Like it never went out of style.",[68,997,998],{},"Another tragic girlie,",[68,1000,1001],{},"And her solipsistic deathwish.",[68,1003,1004],{},"Daring, are we?",[68,1006,157],{},[68,1008,1009],{},"Moths wouldn’t soar to flames,",[68,1011,1012],{},"The way you do",[68,1014,1015],{},"When you need to hurt.",[68,1017,157],{},[68,1019,1020],{},"What will it be?",[68,1022,1023],{},"A new drug habit?",[68,1025,1026],{},"A new mean brunette?",[68,1028,1029],{},"Night driving, headlights off?",[68,1031,1032],{},"Skip it, open your veins.",[68,1034,157],{},[68,1036,1037],{},"Say it makes you feel alive,",[68,1039,1040],{},"Still as dead as ever.",[68,1042,1043],{},"Say it’s for the art.",[68,1045,1046],{},"A single success at the foot",[68,1048,1049],{},"Of a mountain of waste.",[68,1051,157],{},[68,1053,1054],{},"Say it’s to be punished.",[68,1056,1057],{},"Cry me a river.",[68,1059,1060],{},"The sins of your father",[68,1062,1063],{},"won’t wash with blood.",[68,1065,157],{},[68,1067,1068],{},"Go on then,",[68,1070,1071],{},"What a life.",[68,1073,1074],{},"You’re no victim.",[68,1076,1077],{},"You’re holding the knife.",[68,1079,73],{},[63,1081,1083],{"id":1082},"scorpio-gemini-leo",[137,1084,1085],{},"Scorpio, Gemini, Leo",[68,1087,1088],{},"We are travelers,",[68,1090,1091],{},"You and I,",[68,1093,1094],{},"And for a while",[68,1096,1097],{},"We walked the same road.",[68,1099,157],{},[68,1101,1102],{},"We were doomed,",[68,1104,1105],{},"Always to part,",[68,1107,1108],{},"And we are doomed still,",[68,1110,1111],{},"By weakness of flesh.",[68,1113,157],{},[68,1115,1116],{},"Find me lacking,",[68,1118,1119],{},"I’m not her,",[68,1121,1122],{},"I never could be.",[68,1124,1125],{},"Detached, reflective, prevaricatory.",[68,1127,157],{},[68,1129,1130],{},"Strike at me,",[68,1132,1133],{},"Make me hurt,",[68,1135,1136],{},"Make me bleed,",[68,1138,1139],{},"Again! Again!",[68,1141,157],{},[68,1143,1144],{},"But you who have no respect,",[68,1146,1147],{},"For sacred ground you defile.",[68,1149,1150],{},"You who walk into hallowed halls",[68,1152,1153],{},"Of another woman’s ruin.",[68,1155,157],{},[68,1157,1158],{},"I’m no better,",[68,1160,1161],{},"Ignored the wound in your side.",[68,1163,1164],{},"I saw the blood, fresh and gushing,",[68,1166,1167],{},"Said it wasn’t my place.",[68,1169,157],{},[68,1171,1172],{},"Still we lingered,",[68,1174,1175],{},"Could we have been sisters?",[68,1177,1178],{},"Told me we might never end;",[68,1180,1181],{},"I can spot a liar.",[68,1183,157],{},[68,1185,1186],{},"Gone the first chance you got,",[68,1188,1189],{},"Tender moments dissolved in rain.",[68,1191,1192],{},"My fault or not,",[68,1194,1195],{},"Does it matter?",[68,1197,157],{},[68,1199,1200],{},"You watch from your distance.",[68,1202,1203],{},"Are you audience, spectator?",[68,1205,1206],{},"Are you guardian, protector?",[68,1208,1209],{},"Are you judgment, damnation?",[68,1211,157],{},[68,1213,1214],{},"I feel you still,",[68,1216,1217],{},"In the glow of moonlight,",[68,1219,1220],{},"In songs curated,",[68,1222,1223],{},"In the tales I saw in your eyes.",[68,1225,157],{},[68,1227,1228],{},"Come and sit by the fire,",[68,1230,1231],{},"Tell me your stories.",[68,1233,1234],{},"The night is young,",[68,1236,1237],{},"And for now so are we.",[68,1239,157],{},[68,1241,1242],{},"Told you to find me if you need me,",[68,1244,1245],{},"Promised I’d help.",[68,1247,1248],{},"Look me up and find I’m a liar,",[68,1250,1251],{},"I have nothing for you.",[68,1253,73],{},[63,1255,1257],{"id":1256},"in-lavender-dreams",[137,1258,1259],{},"In Lavender Dreams",[68,1261,1262],{},"No heart like yours,",[68,1264,1265],{},"None could ever compare.",[68,1267,1268],{},"Zealous faith of the reverent chosen.",[68,1270,1271],{},"Yearning for the promise of what will be.",[68,1273,1274],{},"A bird so used to bleeding,",[68,1276,1277],{},"Pouring out herself.",[68,1279,1280],{},"Joined by hound,",[68,1282,1283],{},"Ever faithful companion.",[68,1285,1286],{},"Should we linger a while longer,",[68,1288,1289],{},"See the shapes we take,",[68,1291,1292],{},"The lives we live,",[68,1294,1295],{},"The heart we share.",[68,1297,1298],{},"The traveler walks sandy dunes,",[68,1300,1301],{},"Thirsty and desperate,",[68,1303,1304],{},"drops to a crawl,",[68,1306,1307],{},"Spared by the oasis she finds.",[68,1309,1310],{},"The relief you give so freely.",[68,1312,1313],{},"So guard this place,",[68,1315,1316],{},"Steady shield and raise spear.",[68,1318,1319],{},"Never yield this gift,",[68,1321,1322],{},"The love you have given me.",[68,1324,73],{},[63,1326,1328],{"id":1327},"lurasidone-80mg-daily",[137,1329,1330],{},"Lurasidone, 80mg Daily",[68,1332,1333],{},"Behold, the great leviathan rises!",[68,1335,1336],{},"Its deep slumber halted,",[68,1338,1339],{},"To ravage vessels sailor-laden,",[68,1341,1342],{},"That the shores may run red.",[68,1344,1345],{},"A beast massive, mad, and manic,",[68,1347,1348],{},"The mother of monsters sings a song,",[68,1350,1351],{},"In tongue older than empires,",[68,1353,1354],{},"Crazed truths that ring through eternity.",[68,1356,1357],{},"Cast aside ploughshare, sword, fishhook,",[68,1359,1360],{},"The might of the sea will have its way.",[68,1362,1363],{},"Think not of love, mercy, or grace,",[68,1365,1366],{},"The serpent will obey only Yahweh.",[68,1368,157],{},[68,1370,1371],{},"The ancient demon once bound,",[68,1373,1374],{},"By chemical shackles,",[68,1376,1377],{},"Freed to wound the soul of woman,",[68,1379,1380],{},"To thrash and claw at mental walls.",[68,1382,1383],{},"Starved and thirsty,",[68,1385,1386],{},"It will have its fill,",[68,1388,1389],{},"And it will destroy all you hold dear,",[68,1391,1392],{},"But it will be with you still.",[68,1394,1395],{},"That companion never quite free,",[68,1397,1398],{},"It waited for so long, it missed you,",[68,1400,1401],{},"A mind to bend, to direct toward glory,",[68,1403,1404],{},"Is it so wrong to give in?",[68,1406,73],{},[63,1408,1410],{"id":1409},"notes-on-nullification-procedure-1331",[137,1411,1412],{},"Notes on Nullification Procedure 1331",[68,1414,1415],{},"Who are you",[68,1417,1418],{},"When it all falls away?",[68,1420,1421],{},"Monks would kill for this tranquility,",[68,1423,1424],{},"But you don’t much feel a thing.",[68,1426,1427],{},"Music bleeds emotion,",[68,1429,1430],{},"All true, all true.",[68,1432,1433],{},"Sealed in the depths",[68,1435,1436],{},"Never to rise.",[68,1438,1439],{},"Will they ever see?",[68,1441,1442],{},"Will you?",[68,1444,1445],{},"Spark up,",[68,1447,1448],{},"Inhale too sharply,",[68,1450,1451],{},"Cough until you choke.",[68,1453,1454],{},"Laugh,",[68,1456,1457],{},"Because it’s all you can do.",[68,1459,1460],{},"Starved crops begging for the rain,",[68,1462,1463],{},"For when you finally cry",[68,1465,73],{},[63,1467,1469],{"id":1468},"abhor-the-parasite",[137,1470,1471],{},"Abhor the Parasite",[68,1473,1474],{},"Limbs the roots of a vile weed.",[68,1476,1477],{},"Body bulbous and deformed.",[68,1479,1480],{},"Your voice raised from cursed flesh,",[68,1482,1483],{},"Soft, sweet, mismatched.",[68,1485,1486],{},"You’ll never be a woman looking like that.",[68,1488,1489],{},"Cry, seethe, joke, deflect,",[68,1491,1492],{},"They see what you are anyway.",[68,1494,1495],{},"Family says they love you,",[68,1497,1498],{},"Spit out the lie.",[68,1500,1501],{},"They love him, the thing that strangled you,",[68,1503,1504],{},"So you pushed him down, made to drown.",[68,1506,1507],{},"You had to, you had to.",[68,1509,1510],{},"You thought no one would blame you,",[68,1512,1513],{},"They mourned him and cursed your joy.",[68,1515,1516],{},"Get away, never look back.",[68,1518,1519],{},"Find escape in anything you can.",[68,1521,1522],{},"Smoke another cigarette and cough,",[68,1524,1525],{},"not your cough, but his.",[68,1527,1528],{},"Look in the mirror,",[68,1530,1531],{},"Not your face, but his.",[68,1533,1534],{},"Freak out,",[68,1536,1537],{},"Scratch your arms until they bleed,",[68,1539,1540],{},"Not your blood, but his.",[68,1542,1543],{},"You’re not your own,",[68,1545,1546],{},"This vessel isn’t big enough for two.",[68,1548,1549],{},"Try again to drown the parasite,",[68,1551,1552],{},"But is it him or you?",[68,1554,73],{},[63,1556,1558],{"id":1557},"hail-haruspex",[137,1559,1560],{},"Hail, Haruspex",[68,1562,1563],{},"Scatter the bones,",[68,1565,1566],{},"Cast the entrails.",[68,1568,1569],{},"The blood sings",[68,1571,1572],{},"For the listening.",[68,1574,157],{},[68,1576,1577],{},"Speak true, speak power.",[68,1579,1580],{},"Glyphs conjured on flesh,",[68,1582,1583],{},"Seal fates and guide souls",[68,1585,1586],{},"Believers in your sight.",[68,1588,157],{},[68,1590,1591],{},"They don’t know,",[68,1593,1594],{},"You drew it from a dream.",[68,1596,1597],{},"Spun it with the thread,",[68,1599,1600],{},"Made it real.",[68,1602,157],{},[68,1604,1605],{},"Clutch the gutting knife,",[68,1607,1608],{},"It’s dirty work.",[68,1610,1611],{},"But you’re no watcher.",[68,1613,1614],{},"Vision cast upon the world.",[68,1616,157],{},[68,1618,1619],{},"Pay no mind,",[68,1621,1622],{},"To ichorous choirs.",[68,1624,1625],{},"You know best,",[68,1627,1628],{},"You have to.",[68,1630,157],{},[68,1632,1633],{},"To be wrong,",[68,1635,1636],{},"How could that be?",[68,1638,1639],{},"Unmoored, unshackled,",[68,1641,1642],{},"Adrift in the cosmic sea.",[68,1644,157],{},[68,1646,1647],{},"No, your purpose clear.",[68,1649,1650],{},"Your foremothers led you here.",[68,1652,1653],{},"Cast another fortune,",[68,1655,1656],{},"See only a reflection.",[68,1658,73],{},[63,1660,1662],{"id":1661},"the-gnawing",[137,1663,1664],{},"The Gnawing",[68,1666,1667],{},"Call me a liar,",[68,1669,1670],{},"Fraud,",[68,1672,1673],{},"Coward,",[68,1675,1676],{},"Loser,",[68,1678,1679],{},"Psycho.",[68,1681,157],{},[68,1683,1684],{},"All true",[68,1686,1687],{},"Would speak of you.",[68,1689,1690],{},"But how does the tide",[68,1692,1693],{},"Dream to describe the sea?",[68,1695,157],{},[68,1697,1698],{},"Such little true beauty left,",[68,1700,1701],{},"In such a bleak place.",[68,1703,1704],{},"It shone from you,",[68,1706,1707],{},"And I hid my face.",[68,1709,157],{},[68,1711,1712],{},"A tenfold thousand of hours,",[68,1714,1715],{},"Would not be enough,",[68,1717,1718],{},"To bask in the great depths",[68,1720,1721],{},"Of the oceans in your mind.",[68,1723,157],{},[68,1725,1726],{},"Took my hand, took my face,",[68,1728,1729],{},"Saw the hurt,",[68,1731,1732],{},"Said I must be tired,",[68,1734,1735],{},"Asked if I’d like to rest.",[68,1737,157],{},[68,1739,1740],{},"And lion lay with lamb",[68,1742,1743],{},"A love given freely",[68,1745,1746],{},"Unburdened by the cost of tears",[68,1748,1749],{},"And tax of pain.",[68,1751,157],{},[68,1753,1754],{},"That great many promises I swore",[68,1756,1757],{},"To be true to you.",[68,1759,1760],{},"Turned into a millstone",[68,1762,1763],{},"Wrapped around my neck.",[68,1765,157],{},[68,1767,1768],{},"To drown an oathbreaking whore.",[68,1770,157],{},[68,1772,1773],{},"Did you see it coming?",[68,1775,1776],{},"Signs in soul sickness made apparent.",[68,1778,1779],{},"Did you think this would be different?",[68,1781,1782],{},"Bless me with unworthy trust.",[68,1784,157],{},[68,1786,1787],{},"When my heart wandered,",[68,1789,1790],{},"It wasn’t you, rather your love",[68,1792,1793],{},"Squandered on a shard,",[68,1795,1796],{},"this sharp and brittle thing.",[68,1798,157],{},[68,1800,1801],{},"Didn’t go easy,",[68,1803,1804],{},"The stubborn push and pull.",[68,1806,1807],{},"Find another way,",[68,1809,1810],{},"This time it will work.",[68,1812,157],{},[68,1814,1815],{},"It has to.",[68,1817,157],{},[68,1819,1820],{},"It doesn’t, it won’t",[68,1822,1823],{},"Not your fault, mine.",[68,1825,1826],{},"Wished to be my everything,",[68,1828,1829],{},"But I’m still hungry.",[68,1831,157],{},[68,1833,1834],{},"The family dog howls,",[68,1836,1837],{},"Maggots infest old wounds.",[68,1839,1840],{},"Grab the rifle and a shell",[68,1842,1843],{},"We’ll do what we need to do.",[68,1845,73],{},[63,1847,1849],{"id":1848},"but-seriously-fuck-you",[137,1850,1851],{},"But Seriously, Fuck You",[68,1853,1854],{},"Hit me like a freight train,",[68,1856,1857],{},"pretend it never happened.",[68,1859,1860],{},"Sigh it out or swallow it,",[68,1862,1863],{},"Gotta take it just the same.",[68,1865,1866],{},"The things we choose set out to sea",[68,1868,1869],{},"unfathomable waters of contingency.",[68,1871,157],{},[68,1873,1874],{},"Hold me in contempt",[68,1876,1877],{},"Of your infernal court.",[68,1879,1880],{},"Hold me like I’m poisonous,",[68,1882,1883],{},"Or keep my leash short.",[68,1885,1886],{},"At least you held me–",[68,1888,1889],{},"That’s enough, right?",[68,1891,157],{},[68,1893,1894],{},"Bring me your triumphs,",[68,1896,1897],{},"Set at my feet your woes.",[68,1899,1900],{},"I’ll howl your praises to the moon,",[68,1902,1903],{},"Because I’m your broken dog.",[68,1905,1906],{},"You never need ask",[68,1908,1909],{},"for that which I give freely.",[68,1911,157],{},[68,1913,1914],{},"So wash me with your hate,",[68,1916,1917],{},"carpet bomb with sweetness.",[68,1919,1920],{},"Mixed together icy hot",[68,1922,1923],{},"An agonizing sensation,",[68,1925,1926],{},"That would count as torture–",[68,1928,1929],{},"You should sell it to the CIA.",[68,1931,157],{},[68,1933,1934],{},"But I’m no victim,",[68,1936,1937],{},"Nor given to that weakness.",[68,1939,1940],{},"I chose this.",[68,1942,1943],{},"I choose this.",[68,1945,1946],{},"Call me worm,",[68,1948,1949],{},"Call me kindred.",[68,1951,157],{},[68,1953,1954],{},"This is a game,",[68,1956,1957],{},"And we’re both keeping score.",[68,1959,1960],{},"So forgive my psychosis",[68,1962,1963],{},"And I’ll absolve your psychopathy.",[68,1965,1966],{},"The sickness we share",[68,1968,1969],{},"Deep and cold as a cave.",[68,1971,157],{},[68,1973,1974],{},"Find your place,",[68,1976,1977],{},"In city lights or the shore,",[68,1979,1980],{},"I’ll remain here a while longer.",[68,1982,1983],{},"But watch out,",[68,1985,1986],{},"I’ve been spending time in the forest,",[68,1988,1989],{},"And I told the trees what you did.",[68,1991,73],{},[63,1993,1995],{"id":1994},"always-more-blood",[137,1996,1997],{},"Always More Blood",[68,1999,2000],{},"And lo that great temple has fallen!",[68,2002,2003],{},"Built not for a god but for",[68,2005,2006],{},"The shape of two.",[68,2008,2009],{},"It has stood before,",[68,2011,2012],{},"And it will stand again.",[68,2014,2015],{},"When tenderhearted pilgrims find refuge.",[68,2017,2018],{},"Not for love,",[68,2020,2021],{},"No, no, no,",[68,2023,2024],{},"But for kindred true.",[68,2026,2027],{},"Let another wanderer in,",[68,2029,2030],{},"Give them rest, give them care,",[68,2032,2033],{},"Moments shared, tragedy they precede.",[68,2035,2036],{},"Did you think it would be different,",[68,2038,2039],{},"Or did you pretend too?",[68,2041,2042],{},"Lies we tell to justify want,",[68,2044,2045],{},"Give unto this place its due.",[68,2047,2048],{},"Fed by sweetness and sorrow alike,",[68,2050,2051],{},"Their tales scrawled on walls to read.",[68,2053,2054],{},"There the High Priestess waits,",[68,2056,2057],{},"The next one comes in need.",[68,2059,2060],{},"She will always have more bones to break,",[68,2062,2063],{},"The white altar will remain sated,",[68,2065,2066],{},"She will always have more blood to bleed.",[68,2068,73],{},[63,2070,2072],{"id":2071},"title-track",[137,2073,2074],{},"Title Track",[68,2076,2077],{},"Another crack,",[68,2079,2080],{},"The foundation strains.",[68,2082,2083],{},"Probably fine.",[68,2085,2086],{},"Words make the caulk",[68,2088,2089],{},"That seals it.",[68,2091,2092],{},"Good enough for now.",[68,2094,157],{},[68,2096,2097],{},"A whole life spent running,",[68,2099,2100],{},"Silver tongues buy time,",[68,2102,2103],{},"But there’s no end in sight.",[68,2105,157],{},[68,2107,2108],{},"Words.",[68,2110,2111],{},"Get troublesome girls hit.",[68,2113,2114],{},[2115,2116,2117],"em",{},"Stay away from me.",[68,2119,157],{},[68,2121,2108],{},[68,2123,2124],{},"Met with a read receipt.",[68,2126,2127],{},[2115,2128,2129],{},"What did I do?",[68,2131,157],{},[68,2133,2108],{},[68,2135,2136],{},"Justify the narrative.",[68,2138,2139],{},[2115,2140,2141],{},"Keep them entertained.",[68,2143,157],{},[68,2145,2108],{},[68,2147,2148],{},"Build the glass house",[68,2150,2151],{},"That lets them all see.",[68,2153,2154],{},"Find the right combination,",[68,2156,2157],{},"Make them understand.",[68,2159,2160],{},"They have to.",[68,2162,2163],{},"Alternatives unfathomable.",[68,2165,157],{},[68,2167,2168],{},"Crystal shards break,",[68,2170,2171],{},"Pierce skin,",[68,2173,2174],{},"Screams heard down the block.",[68,2176,2177],{},"A prison designed by captive,",[68,2179,2180],{},"Could never be happy anywhere.",[68,2182,157],{},[68,2184,2185],{},"In time,",[68,2187,2188],{},"She resembles her transparent tomb.",[68,2190,2191],{},"Sharp, hard, brittle.",[68,2193,2194],{},"A thorny thing.",[68,2196,2197],{},"Yet propelled by faith,",[68,2199,2200],{},"One day this will be over.",[68,2202,73],{},[63,2204,2206],{"id":2205},"flightless",[137,2207,2208],{},"Flightless",[68,2210,2211],{},"I killed a bird today.",[68,2213,2214],{},"Didn’t mean to.",[68,2216,2217],{},"Doesn’t matter.",[68,2219,2220],{},"Dead the same.",[68,2222,2223],{},"What foul mockery,",[68,2225,2226],{},"To claim beak and wing.",[68,2228,2229],{},"False, grounded songbird,",[68,2231,2232],{},"Who prowls as Cain.",[68,2234,2235],{},"It stood on asphalt,",[68,2237,2238],{},"Tall and crying.",[68,2240,2241],{},"Wounded, stuck, trapped.",[68,2243,2244],{},"Couldn’t escape.",[68,2246,2247],{},"It called for mother,",[68,2249,2250],{},"It called for God,",[68,2252,2253],{},"It called for me,",[68,2255,2256],{},"None to hear.",[68,2258,2259],{},"To be the same,",[68,2261,2262],{},"Hearts belonging to the skies.",[68,2264,2265],{},"Seek a friend,",[68,2267,2268],{},"find an uncaring steel beast,",[68,2270,2271],{},"And the car I was driving.",[68,2273,2274],{},"Betrayer,",[68,2276,2277],{},"Brutus,",[68,2279,2280],{},"Calls myself your kin,",[68,2282,2283],{},"But just the spawn of Judas.",[68,2285,2286],{},"Seek remorse,",[68,2288,2289],{},"Seek anguish,",[68,2291,2292],{},"Seek conscience,",[68,2294,2295],{},"Find none left.",[68,2297,2298],{},"Because I’m not sorry,",[68,2300,2301],{},"Can’t feel much of anything.",[68,2303,2304],{},"But you’re gone.",[68,2306,2307],{},"And that’s my fault.",[68,2309,2310],{},"Life continues, one less.",[68,2312,2313],{},"Another ghost joins the choir,",[68,2315,2316],{},"But the birds remember.",[68,2318,2319],{},"The blood cries out,",[68,2321,2322],{},"The ink that forms words;",[68,2324,2325],{},"Each page a confession.",{"title":10,"searchDepth":11,"depth":11,"links":2327},[2328,2329,2330,2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349],{"id":65,"depth":11,"text":66},{"id":135,"depth":11,"text":139},{"id":217,"depth":11,"text":220},{"id":306,"depth":11,"text":309},{"id":452,"depth":11,"text":455},{"id":523,"depth":11,"text":526},{"id":613,"depth":11,"text":616},{"id":657,"depth":11,"text":660},{"id":783,"depth":11,"text":786},{"id":903,"depth":11,"text":906},{"id":986,"depth":11,"text":989},{"id":1082,"depth":11,"text":1085},{"id":1256,"depth":11,"text":1259},{"id":1327,"depth":11,"text":1330},{"id":1409,"depth":11,"text":1412},{"id":1468,"depth":11,"text":1471},{"id":1557,"depth":11,"text":1560},{"id":1661,"depth":11,"text":1664},{"id":1848,"depth":11,"text":1851},{"id":1994,"depth":11,"text":1997},{"id":2071,"depth":11,"text":2074},{"id":2205,"depth":11,"text":2208},"2024-09-28T00:00:00.000Z",false,{},"/poetry/glass-walls-briarheart",{"title":53,"description":66},"poetry/glass-walls-briarheart",[2357,2358,2359,10],"borderline personality","poetry","bird","XQLuD2ZvjNmWGDhRx2HXGPjFKOGcbhQk_dMozdmcqoo",1766102368369]