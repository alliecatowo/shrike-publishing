el":8,"to":9,"icon":10},{"label":12,"icon":13,"children":95},[96,97,98,99],{"label":16,"to":17,"icon":18},{"label":20,"to":21,"icon":22},{"label":24,"to":25,"icon":26},{"label":28,"to":29,"icon":30},{"label":32,"icon":33,"children":101},[102,103,104],{"label":36,"to":37,"icon":38},{"label":40,"to":41,"icon":42},{"label":44,"to":45,"icon":46},{"label":48,"icon":49,"children":106},[107,108,109],{"label":52,"to":53,"icon":54},{"label":56,"to":57,"icon":54},{"label":59,"to":60,"icon":54},{"label":62,"icon":63,"children":111},[112,113],{"label":66,"to":67,"icon":68},{"label":70,"to":71,"icon":72},{"label":74,"icon":75,"children":115},[116,117,118],{"label":78,"to":79,"icon":80},{"label":82,"to":83,"icon":84},{"label":86,"to":87,"icon":88},"Main","navigation/main","ttV2hx-8FyhWK_60qYhLTnApU2wAPB5d22U2jHRYQeo",{"id":123,"copyright":124,"extension":5,"meta":125,"sections":167,"social":176,"stem":181,"tagline":136,"__hash__":182},"footer/footer/main.yaml","© 2025 Shrike Publishing. All rights reserved.",{"path":126,"shop":127,"body":135,"title":119},"/footer/main",{"title":48,"links":128},[129,131,133],{"platform":130,"url":53,"icon":13},"itch.io",{"platform":56,"url":57,"icon":132},"lucide:book-open",{"platform":59,"url":60,"icon":134},"lucide:coffee",{"copyright":124,"tagline":136,"sections":137,"social":147,"shop":162},"Independent tabletop game publisher",[138],{"title":139,"links":140},"Quick Links",[141,142,143,144,145,146],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":148,"links":149},"Connect",[150,154,158],{"platform":151,"url":152,"icon":153},"Facebook","https://www.facebook.com/shrikepublishing","lucide:facebook",{"platform":155,"url":156,"icon":157},"Twitter","https://twitter.com/ShrikePublisher","lucide:twitter",{"platform":159,"url":160,"icon":161},"Instagram","https://www.instagram.com/shrikepublishing","lucide:instagram",{"title":48,"links":163},[164,165,166],{"platform":130,"url":53,"icon":13},{"platform":56,"url":57,"icon":132},{"platform":59,"url":60,"icon":134},[168],{"title":139,"links":169},[170,171,172,173,174,175],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":148,"links":177},[178,179,180],{"platform":151,"url":152,"icon":153},{"platform":155,"url":156,"icon":157},{"platform":159,"url":160,"icon":161},"footer/main","E2vBIIlIicogpOIWboNqz_CLlxsf1j0-c_bq-o2K-HA",{"id":184,"title":185,"author":186,"body":187,"date":270,"description":271,"extension":272,"featured":273,"image":274,"meta":275,"navigation":273,"path":276,"published":273,"seo":277,"slug":278,"stem":279,"tags":280,"thumbnail":284,"__hash__":285},"blog/blog/tabletop-gaming-trends-2024.md","Musings of the Shrike #2 10/5/2025","Robin Val",{"type":188,"value":189,"toc":264},"minimark",[190,197,205,212,215,218,220,225,228,230,237,239,242,249,251,254,256,259,261],[191,192,194],"h1",{"id":193},"musings-of-the-shrike-2-1052025",[195,196,185],"strong",{},[198,199,200],"p",{},[201,202],"img",{"alt":203,"src":204},"Creator profile picture","https://c10.patreonusercontent.com/4/patreon-media/p/campaign/3234039/2788e93ef83541efb2876ab1768b2d4a/eyJoIjozNjAsInciOjM2MH0%3D/4.png?token-hash=Gf1BXo0_x9ZKMUvAJkap4AkjIHXw1br4gy7VFPJJPok%3D&token-time=1761955200",[206,207,209],"h3",{"id":208},"shrike-publishing-r-val",[195,210,211],{},"Shrike Publishing, R. Val",[213,214],"br",{},[198,216,217],{},"October 5",[213,219],{},[198,221,222],{},[195,223,224],{},"Edit",[198,226,227],{},"I feel a certain tension with the term \"game designer.\" Of course, I am one. I have been since 2019- and even earlier as a homebrewer, but I've also been a lot of other things too. Hell, since 2023 I've put out 2 tabletop game projects and 6 different fiction projects. That's not even counting the 25ish poems released this year.",[213,229],{},[198,231,232,233,236],{},"So, I guess on some level it's just an honor to be known, but whenever someone talks about ",[234,235,20],"em",{}," as a game with fiction about it, I always am a little struck. To me, having lived with this project for two decades, I see EoS as a multimedia franchise with many different ways to experience it. Playing the game and reading the stories are both valid, but neither is centered around the other. The stories you tell are yours, but I have my own canon in mind.",[213,238],{},[198,240,241],{},"------",[198,243,244,245,248],{},"So what am I up to this month? One big thing is reworking the website with the help of Allison, who is a good friend. Also developing Shrike as a business, we're actually doing a big fund drive so expect some activity on this page as I try to get new blood (tell your friends!). Of course, working on an October story. Not quite a horror piece but a lot of religious disturbia, it's called ",[234,246,247],{},"Contempt, My Shield."," Also hoping to start streaming again but I've been a little scrambled.",[213,250],{},[198,252,253],{},"Not every dev diary post is gonna be super long, sometimes i just want to give you a window into my process. Next up, some game dev work and aiming to get some mail out by the end of the week.",[213,255],{},[198,257,258],{},"Until next time.",[213,260],{},[198,262,263],{},"-R.",{"title":265,"searchDepth":266,"depth":266,"links":267},"",2,[268],{"id":208,"depth":269,"text":211},3,"2024-01-10T00:00:00.000Z","The latest devlog from Shrike's R. Val","md",true,"/images/era-of-silence/art/creatures/bantam-spore.png",{},"/blog/tabletop-gaming-trends-2024",{"title":185,"description":271},"shrike-musings-2","blog/tabletop-gaming-trends-2024",[281,282,283],"tabletop","fiction","industry",null,"uMfHu4tHSol_0a343nOMkQs4-z97zuCVbL8OaAXfBgI",[287],{"id":184,"title":185,"author":186,"body":288,"date":270,"description":271,"extension":272,"featured":273,"image":274,"meta":343,"navigation":273,"path":276,"published":273,"seo":344,"slug":278,"stem":279,"tags":345,"thumbnail":284,"