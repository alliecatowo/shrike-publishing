:13,"children":95},[96,97,98,99],{"label":16,"to":17,"icon":18},{"label":20,"to":21,"icon":22},{"label":24,"to":25,"icon":26},{"label":28,"to":29,"icon":30},{"label":32,"icon":33,"children":101},[102,103,104],{"label":36,"to":37,"icon":38},{"label":40,"to":41,"icon":42},{"label":44,"to":45,"icon":46},{"label":48,"icon":49,"children":106},[107,108,109],{"label":52,"to":53,"icon":54},{"label":56,"to":57,"icon":54},{"label":59,"to":60,"icon":54},{"label":62,"icon":63,"children":111},[112,113],{"label":66,"to":67,"icon":68},{"label":70,"to":71,"icon":72},{"label":74,"icon":75,"children":115},[116,117,118],{"label":78,"to":79,"icon":80},{"label":82,"to":83,"icon":84},{"label":86,"to":87,"icon":88},"Main","navigation/main","ttV2hx-8FyhWK_60qYhLTnApU2wAPB5d22U2jHRYQeo",{"id":123,"copyright":124,"extension":5,"meta":125,"sections":167,"social":176,"stem":181,"tagline":136,"__hash__":182},"footer/footer/main.yaml","© 2025 Shrike Publishing. All rights reserved.",{"path":126,"shop":127,"body":135,"title":119},"/footer/main",{"title":48,"links":128},[129,131,133],{"platform":130,"url":53,"icon":13},"itch.io",{"platform":56,"url":57,"icon":132},"lucide:book-open",{"platform":59,"url":60,"icon":134},"lucide:coffee",{"copyright":124,"tagline":136,"sections":137,"social":147,"shop":162},"Independent tabletop game publisher",[138],{"title":139,"links":140},"Quick Links",[141,142,143,144,145,146],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":148,"links":149},"Connect",[150,154,158],{"platform":151,"url":152,"icon":153},"Facebook","https://www.facebook.com/shrikepublishing","lucide:facebook",{"platform":155,"url":156,"icon":157},"Twitter","https://twitter.com/ShrikePublisher","lucide:twitter",{"platform":159,"url":160,"icon":161},"Instagram","https://www.instagram.com/shrikepublishing","lucide:instagram",{"title":48,"links":163},[164,165,166],{"platform":130,"url":53,"icon":13},{"platform":56,"url":57,"icon":132},{"platform":59,"url":60,"icon":134},[168],{"title":139,"links":169},[170,171,172,173,174,175],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":148,"links":177},[178,179,180],{"platform":151,"url":152,"icon":153},{"platform":155,"url":156,"icon":157},{"platform":159,"url":160,"icon":161},"footer/main","E2vBIIlIicogpOIWboNqz_CLlxsf1j0-c_bq-o2K-HA",[184,284],{"id":185,"title":186,"author":187,"body":188,"date":268,"description":269,"extension":270,"featured":271,"image":272,"meta":273,"navigation":271,"path":274,"published":271,"seo":275,"slug":276,"stem":277,"tags":278,"thumbnail":282,"__hash__":283},"blog/blog/designing-era-of-silence.md","Designing the Silent World of Era of Silence","Alex Rivera",{"type":189,"value":190,"toc":260},"minimark",[191,195,203,208,211,215,218,241,245,248,252,255],[192,193,186],"h1",{"id":194},"designing-the-silent-world-of-era-of-silence",[196,197,198,199,202],"p",{},"When we first conceived ",[200,201,20],"em",{},", we wanted to explore a theme that hasn't been deeply explored in tabletop gaming: the power and danger of communication itself. What happens when words become weapons? How do you strategize in a world where speaking could be your downfall?",[204,205,207],"h2",{"id":206},"the-core-concept","The Core Concept",[196,209,210],{},"The central mechanic revolves around the \"Silence Meter\" - a shared resource that represents the ambient noise level in the game world. Players must carefully manage when to speak (play cards) and when to remain silent, creating tense moments of strategic decision-making.",[204,212,214],{"id":213},"balancing-risk-and-reward","Balancing Risk and Reward",[196,216,217],{},"One of the biggest challenges was balancing the risk of speaking against the rewards. We wanted players to feel the weight of every decision:",[219,220,221,229,235],"ul",{},[222,223,224,228],"li",{},[225,226,227],"strong",{},"Speaking",": Powerful effects but increases the Silence Meter",[222,230,231,234],{},[225,232,233],{},"Silence",": Safe but limits your options",[222,236,237,240],{},[225,238,239],{},"Timing",": Perfect timing can turn the tide of battle",[204,242,244],{"id":243},"playtesting-insights","Playtesting Insights",[196,246,247],{},"Through extensive playtesting, we discovered that the most engaging games occurred when players developed unique communication strategies - from elaborate hand signals to coded messages hidden in their card plays.",[204,249,251],{"id":250},"future-expansions","Future Expansions",[196,253,254],{},"We're already planning expansions that will introduce new factions, each with their own approach to the silence paradigm. The \"Whisperers\" faction will focus on subtle, low-risk plays, while the \"Boomers\" will embrace the chaos of loud, high-impact strategies.",[196,256,257,259],{},[200,258,20],{}," launches this month, and we can't wait to hear how you adapt to this silent world!",{"title":261,"searchDepth":262,"depth":262,"links":263},"",2,[264,265,266,267],{"id":206,"depth":262,"text":207},{"id":213,"depth":262,"text":214},{"id":243,"depth":262,"text":244},{"id":250,"depth":262,"text":251},"2024-09-15T00:00:00.000Z","A deep dive into the design philosophy behind our latest game, Era of Silence.","md",true,"/images/blog/era-of-silence-design.jpg",{},"/blog/designing-era-of-silence",{"title":186,"description":269},"designing-era-of-silence","blog/designing-era-of-silence",[279,280,281],"game-design","era-of-silence","tabletop",null,"QXqZMIulYVXFrnnhlgKU0o9gRI3SN2axr8CCcEgd6Q8",{"id":285,"title":286,"author":287,"body":288,"date":361,"description":362,"extension":270,"featured":363,"image":364,"meta":365,"navigation":271,"path":366,"published":271,"seo":367,"slug":368,"stem":369,"tags":370,"thumbnail":282,"__hash__":373},"blog/blog/tabletop-gaming-trends-2024.md","Tabletop Gaming Trends for 2024","Jamie Chen",{"type":189,"value":289,"toc":357},[290,296,303,310,313,316,318,323,326,332,334,337,344,347,349,352,354],[192,291,293],{"id":292},"musings-of-the-shrike-2-1052025",[225,294,295],{},"Musings of the Shrike #2 10/5/2025",[196,297,298],{},[299,300],"img",{"alt":301,"src":302},"Creator profile picture","https://c10.patreonusercontent.com/4/patreon-media/p/campaign/3234039/2788e93ef83541efb2876ab1768b2d4a/eyJoIjozNjAsInciOjM2MH0%3D/4.png?token-hash=Gf1BXo0_x9ZKMUvAJkap4AkjIHXw1br4gy7VFPJJPok%3D&token-time=1761955200",[304,305,307],"h3",{"id":306},"shrike-publishing-r-val",[225,308,309],{},"Shrike Publishing, R. Val",[311,312],"br",{},[196,314,315],{},"October 5",[311,317],{},[196,319,320],{},[225,321,322],{},"Edit",[196,324,325],{},"I feel a certain tension with the term \"game designer.\" Of course, I am one. I have been since 2019- and even earlier as a homebrewer, but I've also been a lot of other things too. Hell, since 2023 I've put out 2 tabletop game projects and 6 different fiction projects. That's not even counting the 25ish poems released this year.",[196,327,328,329,331],{},"So, I guess on some level it's just an honor to be known, but whenever someone talks about ",[200,330,20],{}," as a game with fiction about it, I always am a little struck. To me, having lived with this project for two decades, I see EoS as a multimedia franchise with many different ways to experience it. Playing the game and reading the stories are both valid, but neither is centered around the other. The stories you tell are yours, but I have my own canon in mind.",[311,333],{},[196,335,336],{},"------",[196,338,339,340,343],{},"So what am I up to this month? One big thing is reworking the website with the help of Allison, who is a good friend. Also developing Shrike as a business, we're actually doing a big fund drive so expect some activity on this page as I try to get new blood (tell your friends!). Of course, working on an October story. Not quite a horror piece but a lot of religious disturbia, it's called ",[200,341,342],{},"Contempt, My Shield."," Also hoping to start streaming again but I've been a little scrambled.",[196,345,346],{},"Not every dev diary post is gonna be super long, sometimes i just want to give you a window into my process. Next up, some game dev work and aiming to get some mail out by the end of the week.",[311,348],{},[196,350,351],{},"Until next time.",[311,353],{},[196,355,356],{},"-R.",{"title":261,"searchDepth":262,"depth":262,"links":358},[359],{"id":306,"depth":360,"text":309},3,"2024-01-10T00:00:00.000Z","Our predictions and observations on where the tabletop gaming industry is heading this year.",false,"/images/blog/tabletop-trends.jpg",{},"/blog/tabletop-gaming-trends-2024",{"title":286,"description":362},"tabletop-gaming-trends-2024","blog/tabletop-gaming-trends-2024",[371,372,281],"industry","trends","l9KtOJmeSoS3Uak9x_PTJtleNRuoeaPwJZS_slHCfwM",1760662072951]