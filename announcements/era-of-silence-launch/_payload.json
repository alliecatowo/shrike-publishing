,"icon":10},{"label":12,"icon":13,"children":95},[96,97,98,99],{"label":16,"to":17,"icon":18},{"label":20,"to":21,"icon":22},{"label":24,"to":25,"icon":26},{"label":28,"to":29,"icon":30},{"label":32,"icon":33,"children":101},[102,103,104],{"label":36,"to":37,"icon":38},{"label":40,"to":41,"icon":42},{"label":44,"to":45,"icon":46},{"label":48,"icon":49,"children":106},[107,108,109],{"label":52,"to":53,"icon":54},{"label":56,"to":57,"icon":54},{"label":59,"to":60,"icon":54},{"label":62,"icon":63,"children":111},[112,113],{"label":66,"to":67,"icon":68},{"label":70,"to":71,"icon":72},{"label":74,"icon":75,"children":115},[116,117,118],{"label":78,"to":79,"icon":80},{"label":82,"to":83,"icon":84},{"label":86,"to":87,"icon":88},"Main","navigation/main","ttV2hx-8FyhWK_60qYhLTnApU2wAPB5d22U2jHRYQeo",{"id":123,"copyright":124,"extension":5,"meta":125,"sections":167,"social":176,"stem":181,"tagline":136,"__hash__":182},"footer/footer/main.yaml","© 2025 Shrike Publishing. All rights reserved.",{"path":126,"shop":127,"body":135,"title":119},"/footer/main",{"title":48,"links":128},[129,131,133],{"platform":130,"url":53,"icon":13},"itch.io",{"platform":56,"url":57,"icon":132},"lucide:book-open",{"platform":59,"url":60,"icon":134},"lucide:coffee",{"copyright":124,"tagline":136,"sections":137,"social":147,"shop":162},"Independent storytelling studio bringing fierce adventures and characterful stories to the page and tabletop.",[138],{"title":139,"links":140},"Quick Links",[141,142,143,144,145,146],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":148,"links":149},"Connect",[150,154,158],{"platform":151,"url":152,"icon":153},"Facebook","https://www.facebook.com/shrikepublishing","lucide:facebook",{"platform":155,"url":156,"icon":157},"Twitter","https://twitter.com/ShrikePublisher","lucide:twitter",{"platform":159,"url":160,"icon":161},"Instagram","https://www.instagram.com/shrikepublishing","lucide:instagram",{"title":48,"links":163},[164,165,166],{"platform":130,"url":53,"icon":13},{"platform":56,"url":57,"icon":132},{"platform":59,"url":60,"icon":134},[168],{"title":139,"links":169},[170,171,172,173,174,175],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":148,"links":177},[178,179,180],{"platform":151,"url":152,"icon":153},{"platform":155,"url":156,"icon":157},{"platform":159,"url":160,"icon":161},"footer/main","Zx_njng35scuoXxC-1If1KG5QtS4n9jx-6b-coMogIA",{"id":184,"title":185,"body":186,"date":294,"description":295,"extension":296,"featured":297,"image":298,"meta":299,"navigation":300,"path":301,"published":300,"seo":302,"slug":303,"stem":304,"tags":305,"type":308,"__hash__":309},"announcements/announcements/era-of-silence-launch.md","Era of Silence RPG",{"type":187,"value":188,"toc":290},"minimark",[189,194,201,206,212,223,226,229,231,240,242,253,255,273,275,281,284],[190,191,193],"h1",{"id":192},"era-of-silence-rpg-starter-kit","Era of Silence RPG- Starter Kit",[195,196,197],"p",{},[198,199,200],"strong",{},"1000 years ago, the gods left us.",[195,202,203],{},[198,204,205],{},"400 years ago, our world was buried in ash.",[195,207,208,211],{},[198,209,210],{},"Now, we rely on alchemy and each other to survive."," ",[195,213,214,217,218],{},[198,215,216],{},"This is the"," ",[219,220,221],"em",{},[198,222,20],{},[224,225],"br",{},[195,227,228],{},"In the Long Silence, new monsters have shown their faces, from wasteland mutants to zealous fascists—no corner of the world is truly safe. Grab your team and get ready to fight your way across the shattered surface of Vian!",[224,230],{},[195,232,233,235,236,239],{},[219,234,20],{}," is built on a roll-low dice pool system called ",[198,237,238],{},"Thorne",", designed to allow different characters to excel at the same task as the situation changes. Mixed with an interlocking Trait system, the game heavily emphasizes teamwork in a traditional RPG format! ",[224,241],{},[195,243,244,245,248,249,252],{},"A streamlined character creation process offers ",[198,246,247],{},"over 15,000+ possible character combinations"," that **** can be chosen from in a single sitting. Play a thief with a penchant for machines, a mage with a military background, a combat alchemist, and more! Then grab gear that utilizes a ",[198,250,251],{},"Template + Mod system",". With just a few choices, a standard weapon turns into a trademark with its own twists and effects. ",[224,254],{},[195,256,257,258,260,261,264,265,268,269,272],{},"The core gameplay of ",[219,259,20],{}," is focused on intense, fast combats. A ",[198,262,263],{},"Stamina-focused action mechanic"," and a ",[198,266,267],{},"State system"," allow for tactical freedom in a way that's intuitive for both the Narrator and Protagonist Characters. This coupled with an ",[198,270,271],{},"HP-less damage mechanic"," creates an intense atmosphere where every attack feels lethal and helps combat resolve quickly!",[224,274],{},[195,276,277,278,280],{},"The setting, Vian, was once a place of magic, wonder, and purpose, ruled by the Divine Council. 1,000 years since and the world has been shattered and buried in ash by climate disaster. Yet the mortals the gods once ruled over still persist, surviving and even thriving thanks to alchemical technologies. They created shielded city-states with breathable air, potions that can cure wounds almost instantly, and surgeries that can completely reshape the mortal form! Some cling to hope that the gods may yet return, others have turned toward the idea of nations or empire, and some simply try to keep going and protect the ones they love. As for you, you will find your reason to keep going in the ",[219,279,20],{},". ",[195,282,283],{},"---",[195,285,286,287,289],{},"The ",[219,288,20],{}," Starter Kit comes with a digital Core Rulebook, which is a 197-page PDF with hyperlinks between important entries and alternative text for all images. As well as a form-fillable character sheet, optional rules,  quick reference material, and an introductory module.",{"title":291,"searchDepth":292,"depth":292,"links":293},"",2,[],"2024-09-20T00:00:00.000Z","Alchemical adventures in a god-forsaken world.","md",false,"/images/announcements/era-of-silence-launch.jpg",{},true,"/announcements/era-of-silence-launch",{"title":185,"description":295},"era-of-silence-launch","announcements/era-of-silence-launch",[20,306,307],"Launch","Card Game","product-launch","BSaxtisvTWUXTtB37UNZ_o3xOGn5N5ugTV67xCDzGgk",1761797166146]