12,"icon":13,"children":95},[96,97,98,99],{"label":16,"to":17,"icon":18},{"label":20,"to":21,"icon":22},{"label":24,"to":25,"icon":26},{"label":28,"to":29,"icon":30},{"label":32,"icon":33,"children":101},[102,103,104],{"label":36,"to":37,"icon":38},{"label":40,"to":41,"icon":42},{"label":44,"to":45,"icon":46},{"label":48,"icon":49,"children":106},[107,108,109],{"label":52,"to":53,"icon":54},{"label":56,"to":57,"icon":54},{"label":59,"to":60,"icon":54},{"label":62,"icon":63,"children":111},[112,113],{"label":66,"to":67,"icon":68},{"label":70,"to":71,"icon":72},{"label":74,"icon":75,"children":115},[116,117,118],{"label":78,"to":79,"icon":80},{"label":82,"to":83,"icon":84},{"label":86,"to":87,"icon":88},"Main","navigation/main","ttV2hx-8FyhWK_60qYhLTnApU2wAPB5d22U2jHRYQeo",{"id":123,"copyright":124,"extension":5,"meta":125,"sections":167,"social":176,"stem":181,"tagline":136,"__hash__":182},"footer/footer/main.yaml","© 2025 Shrike Publishing. All rights reserved.",{"path":126,"shop":127,"body":135,"title":119},"/footer/main",{"title":48,"links":128},[129,131,133],{"platform":130,"url":53,"icon":13},"itch.io",{"platform":56,"url":57,"icon":132},"lucide:book-open",{"platform":59,"url":60,"icon":134},"lucide:coffee",{"copyright":124,"tagline":136,"sections":137,"social":147,"shop":162},"Independent tabletop game publisher",[138],{"title":139,"links":140},"Quick Links",[141,142,143,144,145,146],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":148,"links":149},"Connect",[150,154,158],{"platform":151,"url":152,"icon":153},"Facebook","https://www.facebook.com/shrikepublishing","lucide:facebook",{"platform":155,"url":156,"icon":157},"Twitter","https://twitter.com/ShrikePublisher","lucide:twitter",{"platform":159,"url":160,"icon":161},"Instagram","https://www.instagram.com/shrikepublishing","lucide:instagram",{"title":48,"links":163},[164,165,166],{"platform":130,"url":53,"icon":13},{"platform":56,"url":57,"icon":132},{"platform":59,"url":60,"icon":134},[168],{"title":139,"links":169},[170,171,172,173,174,175],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":148,"links":177},[178,179,180],{"platform":151,"url":152,"icon":153},{"platform":155,"url":156,"icon":157},{"platform":159,"url":160,"icon":161},"footer/main","E2vBIIlIicogpOIWboNqz_CLlxsf1j0-c_bq-o2K-HA",[184,240],{"id":185,"title":186,"body":187,"date":224,"description":225,"extension":226,"featured":227,"image":228,"meta":229,"navigation":227,"path":230,"published":227,"seo":231,"slug":232,"stem":233,"tags":234,"type":238,"__hash__":239},"announcements/announcements/blood-neon-expansion.md","Blood Neon Expansion - Atomic Shock",{"type":188,"value":189,"toc":220},"minimark",[190,194,201,204,207,210,212,215,217],[191,192,186],"h1",{"id":193},"blood-neon-expansion-atomic-shock",[195,196,197],"p",{},[198,199,200],"strong",{},"Get Ready for an Atomic Shock!",[195,202,203],{},"Take the fight to another level! ATOMIC SHOCK is the first expansion for BLOOD NEON. It requires the core rulebook to play it. So go pick that up if you haven’t already, or don’t. We’re not cops.",[205,206],"br",{},[195,208,209],{},"The Neon warps all those who fight against it. What becomes of those who lose themselves? The ones who go Neon? What is it like to be ripped apart and put back together on the atomic level? To turn on the Neon Hunters they once called kin? Those who have turned are now as monstrous as the hordes they once battled. You’ll need to take them down just the same.",[205,211],{},[195,213,214],{},"What about you? What powers are you willing to lose yourself for, as the corruption takes hold? Maybe you won’t, and you’ll hold fast to the things you knew? Kinda boring, to be honest.",[205,216],{},[195,218,219],{},"ATOMIC SHOCK is designed for players of all experience levels with BLOOD NEON. It introduces fiendishly corrupted versions of your Stars to serve as enemies. As well, awesome mechanics focusing on corruption, and rewards for finishing combats as fast as possible. New gear gives mid-to-late game players more toys to shred through the Neon, as well as an epic host of consumables and cosmetics to benefit all players! All geared up and itching for a fight? Take on the SLAUGHTERPATH: The Fortress of Records! The time has come, Hunter. The hordes may have grown stronger, but so have you. The only thing that stands between the 11th Realm and annihilation. Fight, die, respawn, and fight some more!",{"title":221,"searchDepth":222,"depth":222,"links":223},"",2,[],"2024-10-15T00:00:00.000Z","Power up and try not to lose yourself in this unleashed ttrpg expansion!","md",true,"/images/announcements/blood-neon-expansion.jpg",{},"/announcements/blood-neon-expansion",{"title":186,"description":225},"blood-neon-expansion","announcements/blood-neon-expansion",[24,235,236,237],"Expansion","Cyberpunk","TTRPG","expansion","2iHcgOyABL2YQfwpA3AW1zv7v4O9eUFO-Qzks4MZOgM",{"id":241,"title":242,"body":243,"date":322,"description":323,"extension":226,"featured":324,"image":325,"meta":326,"navigation":227,"path":327,"published":227,"seo":328,"slug":329,"stem":330,"tags":331,"type":334,"__hash__":335},"announcements/announcements/era-of-silence-launch.md","Era of Silence - Now Available!",{"type":188,"value":244,"toc":317},[245,248,255,260,267,271,293,297,300,314],[191,246,242],{"id":247},"era-of-silence-now-available",[195,249,250,251,254],{},"We're thrilled to announce that ",[252,253,20],"em",{}," is now available for purchase! After two years of development and extensive playtesting, our strategic card game about a world where silence is power is ready for your table.",[256,257,259],"h2",{"id":258},"launch-special","Launch Special",[195,261,262,263,266],{},"For the first week of release, get 20% off when you order directly from our store. Use code ",[198,264,265],{},"SILENT20"," at checkout.",[256,268,270],{"id":269},"where-to-buy","Where to Buy",[272,273,274,281,287],"ul",{},[275,276,277,280],"li",{},[198,278,279],{},"Direct from Shrike Publishing",": Best pricing and includes exclusive art print",[275,282,283,286],{},[198,284,285],{},"Local Game Stores",": Find retailers near you",[275,288,289,292],{},[198,290,291],{},"Online Retailers",": Available on major platforms",[256,294,296],{"id":295},"launch-events","Launch Events",[195,298,299],{},"Join us for launch events at:",[272,301,302,308],{},[275,303,304,307],{},[198,305,306],{},"GameCon 2024",": Booth #245",[275,309,310,313],{},[198,311,312],{},"Local Meetups",": Check our events page for dates",[195,315,316],{},"Thank you to all our backers, playtesters, and the tabletop community for making this possible!",{"title":221,"searchDepth":222,"depth":222,"links":318},[319,320,321],{"id":258,"depth":222,"text":259},{"id":269,"depth":222,"text":270},{"id":295,"depth":222,"text":296},"2024-09-20T00:00:00.000Z","Our latest strategic card game is now shipping worldwide.",false,"/images/announcements/era-of-silence-launch.jpg",{},"/announcements/era-of-silence-launch",{"title":242,"description":323},"era-of-silence-launch","announcements/era-of-silence-launch",[20,332,333],"Launch","Card Game","product-launch","oQC6kYPDgEZlRL8zHiRbvsavzpLTRxs-xvxrwxcjeAY",1760660741672]