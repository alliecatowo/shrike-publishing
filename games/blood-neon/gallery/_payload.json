n":327},"artwork/blood-neon/all-enemies",[],"enemy","kzRHL4nHZMGGUA1fasfxYdoj9Q3T3VbQddVre7nwnBw",{"id":337,"title":338,"artist":318,"body":339,"date":346,"description":347,"extension":235,"featured":124,"fullImage":236,"game":131,"meta":348,"navigation":124,"path":349,"published":124,"seo":350,"stem":351,"tags":352,"thumbnail":236,"type":353,"__hash__":354},"artwork/artwork/blood-neon/cover.md","Blood Neon - Game Cover",{"type":126,"value":340,"toc":344},[341],[138,342,343],{},"The official cover art for Blood Neon showcases the game's distinctive purple and pink neon cyberpunk aesthetic. This action-packed cover sets the tone for the intense card-based combat experience that awaits players.",{"title":227,"searchDepth":228,"depth":228,"links":345},[],"2024-02-15T00:00:00.000Z","The official cover art for Blood Neon, featuring the game's iconic logo and vibrant cyberpunk aesthetic",{},"/artwork/blood-neon/cover",{"title":338,"description":347},"artwork/blood-neon/cover",[],"cover","85TylB9gvZBo0Yza7se_gbkisFinY4Jt0y9q_yg1v7k",{"id":356,"title":357,"artist":318,"body":358,"date":365,"description":366,"extension":235,"featured":124,"fullImage":367,"game":131,"meta":368,"navigation":124,"path":369,"published":124,"seo":370,"stem":371,"tags":372,"thumbnail":367,"type":373,"__hash__":374},"artwork/artwork/blood-neon/four-characters.md","Blood Neon - Four Main Characters",{"type":126,"value":359,"toc":363},[360],[138,361,362],{},"The four main characters of Blood Neon stand ready for action in this dynamic character lineup. Each character brings unique abilities and playstyles to the cyberpunk card game, set against the signature purple and pink neon aesthetic that defines Blood Neon's visual identity.",{"title":227,"searchDepth":228,"depth":228,"links":364},[],"2024-02-28T00:00:00.000Z","The four main playable characters of Blood Neon in dynamic action poses, showcasing the game's vibrant neon cyberpunk aesthetic","/images/blood-neon/characters/blood-neon-four-characters.jpg",{},"/artwork/blood-neon/four-characters",{"title":357,"description":366},"artwork/blood-neon/four-characters",[],"character","aJ4aBheHeTnjRHsQFab3oqvTv_0Q1azmQYcT7Dyys40",{"id":376,"title":377,"artist":318,"body":378,"date":385,"description":386,"extension":235,"featured":387,"fullImage":388,"game":131,"meta":389,"navigation":124,"path":390,"published":124,"seo":391,"stem":392,"tags":393,"thumbnail":388,"type":373,"__hash__":394},"artwork/artwork/blood-neon/infuser.md","Blood Neon - The Infuser",{"type":126,"value":379,"toc":383},[380],[138,381,382],{},"The Infuser is one of Blood Neon's most enigmatic characters, wielding the power to enhance and modify cybernetic augmentations. This character portrait captures the essence of the game's cyberpunk world where technology and humanity blur.",{"title":227,"searchDepth":228,"depth":228,"links":384},[],"2024-03-05T00:00:00.000Z","The mysterious Infuser character, a key figure in the Blood Neon universe with powerful augmentation abilities",false,"/images/blood-neon/characters/blood-neon-infuser.jpg",{},"/artwork/blood-neon/infuser",{"title":377,"description":386},"artwork/blood-neon/infuser",[],"PuHYyn1NR5tVgDqwlV86YXku7AJ8-_Kldh9UPpBUZc0",1761798005635]