m.com/shrikepublishing","lucide:instagram",{"title":48,"links":163},[164,165,166],{"platform":130,"url":53,"icon":13},{"platform":56,"url":57,"icon":132},{"platform":59,"url":60,"icon":134},[168],{"title":139,"links":169},[170,171,172,173,174,175],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":148,"links":177},[178,179,180],{"platform":151,"url":152,"icon":153},{"platform":155,"url":156,"icon":157},{"platform":159,"url":160,"icon":161},"footer/main","sMJVBtaTsfQ3viD1cLZ8J5WDYDJcZs1N8U-IVzvZ870",{"id":184,"title":24,"available":185,"body":186,"coverImage":298,"currency":299,"date":300,"description":301,"extension":302,"featured":185,"image":303,"manualUrl":298,"meta":304,"navigation":185,"path":25,"playTime":298,"playerCount":298,"price":305,"published":185,"releaseDate":298,"resources":306,"seo":311,"slug":192,"stem":312,"tags":313,"thumbnail":298,"__hash__":318},"games/games/blood-neon.md",true,{"type":187,"value":188,"toc":289},"minimark",[189,193,198,206,210,239,243,260,264,267,273,277,286],[190,191,24],"h1",{"id":192},"blood-neon",[194,195,197],"h2",{"id":196},"overview","Overview",[199,200,201,202,205],"p",{},"Welcome to Neo-Tokyo, where corporations rule and hackers fight back. ",[203,204,24],"em",{}," is a cooperative tabletop RPG where players take on the roles of elite hackers navigating the dangerous underworld of a cyberpunk metropolis.",[194,207,209],{"id":208},"game-features","Game Features",[211,212,213,221,227,233],"ul",{},[214,215,216,220],"li",{},[217,218,219],"strong",{},"Cooperative Play",": Work together to complete missions and uncover conspiracies",[214,222,223,226],{},[217,224,225],{},"Character Customization",": Create unique hacker characters with cybernetic enhancements",[214,228,229,232],{},[217,230,231],{},"Dynamic Storytelling",": Branching narratives based on player choices",[214,234,235,238],{},[217,236,237],{},"Miniature Components",": Detailed miniatures and terrain pieces",[194,240,242],{"id":241},"whats-included","What's Included",[211,244,245,248,251,254,257],{},[214,246,247],{},"Core rulebook with complete campaign",[214,249,250],{},"Character sheets and customization options",[214,252,253],{},"28mm scale miniatures (4 player characters, various NPCs)",[214,255,256],{},"Modular city terrain tiles",[214,258,259],{},"Dice set and tokens",[194,261,263],{"id":262},"purchase-options","Purchase Options",[199,265,266],{},"Available now on our store for $24.99 USD plus shipping.",[199,268,269],{},[270,271,272],"a",{"href":87},"Buy Now",[194,274,276],{"id":275},"license-community-engagement","License & Community Engagement",[199,278,279,281,282,285],{},[203,280,24],{}," core rules are available under a ",[217,283,284],{},"Creative Commons Attribution-ShareAlike 4.0 (CC BY-SA 4.0)"," license. This means you can hack it, remix it, create your own campaigns, and share them with the community - just give us credit and share your work under the same license.",[199,287,288],{},"Join our Discord community to share your Blood Neon campaigns and get tips from other players!",{"title":290,"searchDepth":291,"depth":291,"links":292},"",2,[293,294,295,296,297],{"id":196,"depth":291,"text":197},{"id":208,"depth":291,"text":209},{"id":241,"depth":291,"text":242},{"id":262,"depth":291,"text":263},{"id":275,"depth":291,"text":276},null,"USD","2024-03-15T00:00:00.000Z","Cyberpunk adventure in the neon-lit streets of Neo-Tokyo.","md","/images/blood-neon/cover/blood-neon-cover.jpg",{},24.99,[307,309],{"title":308,"url":67},"Faction Guide",{"title":310,"url":67},"GM Screen",{"title":24,"description":301},"games/blood-neon",[314,315,316,317],"tabletop","cyberpunk","adventure","cooperative","E8jPgdvkKTbcxhQK3y4gA7Mat0556b2BUOrr0njLgoY",[],[321,397,548],{"id":184,"title":24,"available":185,"body":322,"coverImage":298,"currency":299,"date":300,"description":301,"extension":302,"featured":185,"image":303,"manualUrl":298,"meta":391,"navigation":185,"path":25,"playTime":298,"playerCount":298,"price":305,"published":185,"releaseDate":298,"resources":392,"seo":395,"slug":192,"stem":312,"tags":396,"thumbnail":298,"__hash__":318},{"type":187,"value":323,"toc":384},[324,326,328,332,334,352,354,366,368,370,374,376,382],[190,325,24],{"id":192},[194,327,197],{"id":196},[199,329,201,330,205],{},[203,331,24],{},[194,333,209],{"id":208},[211,335,336,340,344,348],{},[214,337,338,220],{},[217,339,219],{},[214,341,342,226],{},[217,343,225],{},[214,345,346,232],{},[217,347,231],{},[214,349,350,238],{},[217,351,237],{},[194,353,242],{"id":241},[211,355,356,358,360,362,364],{},[214,357,247],{},[214,359,250],{},[214,361,253],{},[214,363,256],{},[214,365,259],{},[194,367,263],{"id":262},[199,369,266],{},[199,371,372],{},[270,373,272],{"href":87},[194,375,276],{"id":275},[199,377,378,281,380,285],{},[203,379,24],{},[217,381,284],{},[199,383,288],{},{"title":290,"searchDepth":291,"depth":291,"links":385},[386,387,388,389,390],{"id":196,"depth":291,"text":197},{"id":208,"depth":291,"text":209},{"id":241,"depth":291,"text":242},{"id":262,"depth":291,"text":263},{"id":275,"depth":291,"text":276},{},[393,394],{"title":308,"url":67},{"title":310,"url":67},{"title":24,"description":301},[314,315,316,317],{"id":398,"title":20,"available":185,"body":399,"coverImage":298,"currency":299,"date":529,"description":530,"extension":302,"featured":185,"image":531,"manualUrl":57,"meta":532,"navigation":185,"path":21,"playTime":298,"playerCount":298,"price":533,"published":185,"releaseDate":298,"resources":534,"seo":540,"slug":541,"stem":542,"tags":543,"thumbnail":298,"__hash__":547},"games/games/era-of-silence.md",{"type":187,"value":400,"toc":526},[401,405,409,414,419,425,435,442,445,448,457,464,475,477,495,497,503,506,508,514,521],[190,402,404],{"id":403},"era-of-silence-rpg","Era of Silence RPG",[194,406,408],{"id":407},"tactical-chemipunk-action-for-teams-of-3-6-players","Tactical chemipunk action for teams of 3-6 players.",[199,410,411],{},[217,412,413],{},"1000 years ago, the gods left us.",[199,415,416],{},[217,417,418],{},"400 years ago, our world was buried in ash.",[199,420,421,424],{},[217,422,423],{},"Now, we rely on alchemy and each other to survive."," ",[199,426,427,430,431],{},[217,428,429],{},"This is the"," ",[203,432,433],{},[217,434,20],{},[199,436,437],{},[438,439],"img",{"alt":440,"src":441},"undefined","https://img.itch.zone/aW1nLzk2ODgzMDEuanBn/original/0BAo%2Fa.jpg",[199,443,444],{},"In the Long Silence, new monsters have shown their faces, from wasteland mutants to zealous fascists—no corner of the world is truly safe. Grab your team and get ready to fight your way across the shattered surface of Vian!",[446,447],"br",{},[199,449,450,452,453,456],{},[203,451,20],{}," is built on a roll-low dice pool system called ",[217,454,455],{},"Thorne",", designed to allow different characters to excel at the same task as the situation changes. Mixed with an interlocking Trait system, the game heavily emphasizes teamwork in a traditional RPG format! ",[199,458,459,461],{},[446,460],{},[438,462],{"alt":440,"src":463},"https://img.itch.zone/aW1nLzk2ODgyNDguanBn/original/bfLoDC.jpg",[199,465,466,467,470,471,474],{},"A streamlined character creation process offers ",[217,468,469],{},"over 15,000+ possible character combinations"," that **** can be chosen from in a single sitting. Play a thief with a penchant for machines, a mage with a military background, a combat alchemist, and more! Then grab gear that utilizes a ",[217,472,473],{},"Template + Mod system",". With just a few choices, a standard weapon turns into a trademark with its own twists and effects. ",[446,476],{},[199,478,479,480,482,483,486,487,490,491,494],{},"The core gameplay of ",[203,481,20],{}," is focused on intense, fast combats. A ",[217,484,485],{},"Stamina-focused action mechanic"," and a ",[217,488,489],{},"State system"," allow for tactical freedom in a way that's intuitive for both the Narrator and Protagonist Characters. This coupled with an ",[217,492,493],{},"HP-less damage mechanic"," creates an intense atmosphere where every attack feels lethal and helps combat resolve quickly!",[446,496],{},[199,498,499,500,502],{},"The setting, Vian, was once a place of magic, wonder, and purpose, ruled by the Divine Council. 1,000 years since and the world has been shattered and buried in ash by climate disaster. Yet the mortals the gods once ruled over still persist, surviving and even thriving thanks to alchemical technologies. They created shielded city-states with breathable air, potions that can cure wounds almost instantly, and surgeries that can completely reshape the mortal form! Some cling to hope that the gods may yet return, others have turned toward the idea of nations or empire, and some simply try to keep going and protect the ones they love. As for you, you will find your reason to keep going in the ",[203,501,20],{},". ",[199,504,505],{},"---",[446,507],{},[199,509,510,511,513],{},"The ",[203,512,20],{}," Starter Kit comes with a digital Core Rulebook, which is a 197-page PDF with hyperlinks between important entries and alternative text for all images. As well as a form-fillable character sheet, optional rules,  quick reference material, and an introductory module.",[199,515,516],{},[270,517,518],{"href":518,"rel":519},"https://shrikepublishing.itch.io/era-of-silence",[520],"nofollow",[199,522,523],{},[438,524],{"alt":440,"src":525},"https://img.itch.zone/aW1nLzk2ODgzNTguanBn/original/Gqt2zp.jpg",{"title":290,"searchDepth":291,"depth":291,"links":527},[528],{"id":407,"depth":291,"text":408},"2024-01-20T00:00:00.000Z","A strategic tabletop game set in a dystopian future where silence is the ultimate weapon.","/images/era-of-silence/cover/era-of-silence-cover.png",{},29.99,[535,538],{"title":536,"url":537},"Quick Reference Guide","/resources/era-of-silence-quick-reference",{"title":539,"url":67},"Character Sheets",{"title":20,"description":530},"era-of-silence","games/era-of-silence",[314,544,545,546],"strategy","dystopian","card-game","xAgiE_iWozefijry_pqAlQqLn0qCQu5TswVeHevZdMI",{"id":549,"title":550,"available":185,"body":551,"coverImage":298,"currency":299,"date":706,"description":707,"extension":302,"featured":708,"image":709,"manualUrl":53,"meta":710,"navigation":185,"path":711,"playTime":298,"playerCount":298,"price":712,"published":185,"releaseDate":298,"resources":713,"seo":716,"slug":717,"stem":718,"tags":719,"thumbnail":298,"__hash__":724},"games/games/get-in-loser-we-re-going-to-steal-the-kilogram.md","Get in Loser, We're Going to Steal the Kilogram",{"type":187,"value":552,"toc":703},[553,556,562,570,577,579,586,588,595,597,603,605,612,614,617,619,626,628,630,632,635,637,640,642,649,651,658,660,667,669,672,674,679,681,684,686,689,691,694,700],[190,554,550],{"id":555},"get-in-loser-were-going-to-steal-the-kilogram",[199,557,558],{},[438,559],{"alt":560,"src":561},"v2LeUW.png","/bafkreiahgxziaisasw5ec2xoi27d2mk5k5s2ye3fk7rjr4vkwpwngumtsi.jpg",[194,563,565],{"id":564},"an-action-packed-heist-for-all-ages",[203,566,567],{},[217,568,569],{},"An action-packed heist for all ages!",[199,571,572],{},[203,573,574],{},[217,575,576],{},"The year is 2017.",[446,578],{},[199,580,581,424],{},[203,582,583],{},[217,584,585],{},"The model kilogram is a year away from retirement.",[446,587],{},[199,589,590],{},[203,591,592],{},[217,593,594],{},"Now is your time!",[446,596],{},[199,598,599,602],{},[203,600,601],{},"Get In Loser, We're Stealing the Kilogram"," takes place during the World Middle School Science Fair, with the eponymous model kilogram as its centerpiece. This game tells two stories: ",[446,604],{},[199,606,607,608,611],{},"The dashing ",[217,609,610],{},"Illustrious Aces",", a heist crew preparing for their final big score, but there's a hitch. Your wheelman ghosted you the day of the job. You have the training, but you'll have to make do with gadgets scrounged from the middle school science fair. ",[446,613],{},[199,615,616],{},"OR",[446,618],{},[199,620,621,622,625],{},"The plucky ",[217,623,624],{},"Grape Juice Gang",", a well-bonded set of middle schoolers who just found a bag of spy gear. Summer break is coming up, and wouldn't nabbing that cool kilogram be a great way to send yourselves off?",[446,627],{},[199,629,616],{},[446,631],{},[199,633,634],{},"Play the two teams against each other in an epic and wacky adventure. ",[446,636],{},[199,638,639],{},"But be careful! ",[446,641],{},[199,643,644,645,648],{},"Whichever run you choose, ",[217,646,647],{},"Junior Detective Jenny Venetti"," is on the case, and she's hot on your trail!",[446,650],{},[199,652,653],{},[203,654,655],{},[217,656,657],{},"Two Teams,",[446,659],{},[199,661,662,424],{},[203,663,664],{},[217,665,666],{},"One Prize.",[446,668],{},[199,670,671],{},"Can you nab the kilogram and get out before Detective Jenny and the authorities close in? ",[446,673],{},[199,675,676,678],{},[203,677,601],{}," is a oneshot heist ttrpg designed to be played in one of 3 possible runs, as described above. The dice mechanic is simple but intuitive. You want to hit the center of your dice's range (so a 5 and a 6 on a d10). The GJG gets more dice to represent their chaos, but the IA gets better but less dice to represent the focus of their training. Skills and gear vary thematically between the overgeared adolescents and the improvising professionals.",[446,680],{},[199,682,683],{},"Build a heister quickly, and run the entire thing in a couple of hours! Great for parties!",[446,685],{},[199,687,688],{},"Your purchase includes the A5 sized singles and spreads for the document at print quality. 8 Pages, in color. ",[446,690],{},[199,692,693],{},"A collaboration between Shrike Publishing and Rathayibacter. ",[199,695,696],{},[270,697,698],{"href":698,"rel":699},"https://shrikepublishing.itch.io/get-in-loser-were-stealing-the-kilogram",[520],[701,702],"hr",{},{"title":290,"searchDepth":291,"depth":291,"links":704},[705],{"id":564,"depth":291,"text":569},"2024-11-10T00:00:00.000Z","A chaotic heist game about stealing the international prototype kilogram from a climate-controlled vault in Paris. For 2-5 players who believe measurement should belong to everyone.",false,"/ShrikeLogoNov2021.png",{},"/games/get-in-loser-we-re-going-to-steal-the-kilogram",15,[714],{"title":715,"url":53},"Print & Play Version",{"title":550,"description":707},"steal-the-kilogram","games/get-in-loser-we-re-going-to-steal-the-kilogram",[314,720,721,722,723],"heist","comedy","one-shot","print-and-play","YmcZelmPA1Sar_76QyK5iYefhC_x1SJph4AhH4SByog",1760840740040]