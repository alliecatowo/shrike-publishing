114],{"label":8,"to":9,"icon":10},{"label":12,"icon":13,"children":95},[96,97,98,99],{"label":16,"to":17,"icon":18},{"label":20,"to":21,"icon":22},{"label":24,"to":25,"icon":26},{"label":28,"to":29,"icon":30},{"label":32,"icon":33,"children":101},[102,103,104],{"label":36,"to":37,"icon":38},{"label":40,"to":41,"icon":42},{"label":44,"to":45,"icon":46},{"label":48,"icon":49,"children":106},[107,108,109],{"label":52,"to":53,"icon":54},{"label":56,"to":57,"icon":54},{"label":59,"to":60,"icon":54},{"label":62,"icon":63,"children":111},[112,113],{"label":66,"to":67,"icon":68},{"label":70,"to":71,"icon":72},{"label":74,"icon":75,"children":115},[116,117,118],{"label":78,"to":79,"icon":80},{"label":82,"to":83,"icon":84},{"label":86,"to":87,"icon":88},"Main","navigation/main","ttV2hx-8FyhWK_60qYhLTnApU2wAPB5d22U2jHRYQeo",{"id":123,"title":124,"available":125,"body":126,"coverImage":294,"currency":295,"date":296,"description":297,"extension":298,"featured":299,"image":290,"manualUrl":283,"meta":300,"navigation":125,"path":301,"playTime":294,"playerCount":294,"price":302,"published":125,"releaseDate":294,"resources":303,"seo":306,"slug":307,"stem":308,"tags":309,"thumbnail":294,"__hash__":315},"games/games/get-in-loser-we-re-going-to-steal-the-kilogram.md","Get in Loser, We're Going to Steal the Kilogram",true,{"type":127,"value":128,"toc":289},"minimark",[129,133,141,152,159,162,170,172,179,181,187,189,196,198,201,203,210,212,214,216,219,221,224,226,233,235,242,244,251,253,256,258,263,265,268,270,273,275,278,286],[130,131,124],"h1",{"id":132},"get-in-loser-were-going-to-steal-the-kilogram",[134,135,136],"p",{},[137,138],"img",{"alt":139,"src":140},"v2LeUW.png","/bafkreiahgxziaisasw5ec2xoi27d2mk5k5s2ye3fk7rjr4vkwpwngumtsi.jpg",[142,143,145],"h2",{"id":144},"an-action-packed-heist-for-all-ages",[146,147,148],"em",{},[149,150,151],"strong",{},"An action-packed heist for all ages!",[134,153,154],{},[146,155,156],{},[149,157,158],{},"The year is 2017.",[160,161],"br",{},[134,163,164,169],{},[146,165,166],{},[149,167,168],{},"The model kilogram is a year away from retirement."," ",[160,171],{},[134,173,174],{},[146,175,176],{},[149,177,178],{},"Now is your time!",[160,180],{},[134,182,183,186],{},[146,184,185],{},"Get In Loser, We're Stealing the Kilogram"," takes place during the World Middle School Science Fair, with the eponymous model kilogram as its centerpiece. This game tells two stories: ",[160,188],{},[134,190,191,192,195],{},"The dashing ",[149,193,194],{},"Illustrious Aces",", a heist crew preparing for their final big score, but there's a hitch. Your wheelman ghosted you the day of the job. You have the training, but you'll have to make do with gadgets scrounged from the middle school science fair. ",[160,197],{},[134,199,200],{},"OR",[160,202],{},[134,204,205,206,209],{},"The plucky ",[149,207,208],{},"Grape Juice Gang",", a well-bonded set of middle schoolers who just found a bag of spy gear. Summer break is coming up, and wouldn't nabbing that cool kilogram be a great way to send yourselves off?",[160,211],{},[134,213,200],{},[160,215],{},[134,217,218],{},"Play the two teams against each other in an epic and wacky adventure. ",[160,220],{},[134,222,223],{},"But be careful! ",[160,225],{},[134,227,228,229,232],{},"Whichever run you choose, ",[149,230,231],{},"Junior Detective Jenny Venetti"," is on the case, and she's hot on your trail!",[160,234],{},[134,236,237],{},[146,238,239],{},[149,240,241],{},"Two Teams,",[160,243],{},[134,245,246,169],{},[146,247,248],{},[149,249,250],{},"One Prize.",[160,252],{},[134,254,255],{},"Can you nab the kilogram and get out before Detective Jenny and the authorities close in? ",[160,257],{},[134,259,260,262],{},[146,261,185],{}," is a oneshot heist ttrpg designed to be played in one of 3 possible runs, as described above. The dice mechanic is simple but intuitive. You want to hit the center of your dice's range (so a 5 and a 6 on a d10). The GJG gets more dice to represent their chaos, but the IA gets better but less dice to represent the focus of their training. Skills and gear vary thematically between the overgeared adolescents and the improvising professionals.",[160,264],{},[134,266,267],{},"Build a heister quickly, and run the entire thing in a couple of hours! Great for parties!",[160,269],{},[134,271,272],{},"Your purchase includes the A5 sized singles and spreads for the document at print quality. 8 Pages, in color. ",[160,274],{},[134,276,277],{},"A collaboration between Shrike Publishing and Rathayibacter. ",[134,279,280],{},[281,282,283],"a",{"href":283,"rel":284},"https://shrikepublishing.itch.io/get-in-loser-were-stealing-the-kilogram",[285],"nofollow",[287,288],"hr",{},{"title":290,"searchDepth":291,"depth":291,"links":292},"",2,[293],{"id":144,"depth":291,"text":151},null,"USD","2025-09-09T00:00:00.000Z","A chaotic heist game about one of two teams stealing the most famous of weights. ","md",false,{},"/games/get-in-loser-we-re-going-to-steal-the-kilogram",7.5,[304],{"title":305,"url":53},"Print & Play Version",{"title":124,"description":297},"steal-the-kilogram","games/get-in-loser-we-re-going-to-steal-the-kilogram",[310,311,312,313,314],"tabletop","heist","comedy","one-shot","print-and-play","BmtJ48ZZ9b2HMiw389uKsruLWaHYRv4atBmhY9s3GYs",{"id":317,"copyright":318,"extension":5,"meta":319,"sections":361,"social":370,"stem":375,"tagline":330,"__hash__":376},"footer/footer/main.yaml","© 2025 Shrike Publishing. All rights reserved.",{"path":320,"shop":321,"body":329,"title":119},"/footer/main",{"title":48,"links":322},[323,325,327],{"platform":324,"url":53,"icon":13},"itch.io",{"platform":56,"url":57,"icon":326},"lucide:book-open",{"platform":59,"url":60,"icon":328},"lucide:coffee",{"copyright":318,"tagline":330,"sections":331,"social":341,"shop":356},"Independent storytelling studio bringing fierce adventures and characterful stories to the page and tabletop.",[332],{"title":333,"links":334},"Quick Links",[335,336,337,338,339,340],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":342,"links":343},"Connect",[344,348,352],{"platform":345,"url":346,"icon":347},"Facebook","https://www.facebook.com/shrikepublishing","lucide:facebook",{"platform":349,"url":350,"icon":351},"Twitter","https://twitter.com/ShrikePublisher","lucide:twitter",{"platform":353,"url":354,"icon":355},"Instagram","https://www.instagram.com/shrikepublishing","lucide:instagram",{"title":48,"links":357},[358,359,360],{"platform":324,"url":53,"icon":13},{"platform":56,"url":57,"icon":326},{"platform":59,"url":60,"icon":328},[362],{"title":333,"links":363},[364,365,366,367,368,369],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":342,"links":371},[372,373,374],{"platform":345,"url":346,"icon":347},{"platform":349,"url":350,"icon":351},{"platform":353,"url":354,"icon":355},"footer/main","Zx_njng35scuoXxC-1If1KG5QtS4n9jx-6b-coMogIA",[378],{"id":379,"title":380,"artist":381,"body":382,"date":479,"description":480,"extension":298,"featured":125,"fullImage":481,"game":307,"meta":482,"navigation":125,"path":483,"published":125,"seo":484,"stem":485,"tags":486,"thumbnail":481,"type":487,"__hash__":488},"artwork/artwork/steal-the-kilogram/cover.md","Steal the Kilogram - Game Cover","Shrike Team",{"type":127,"value":383,"toc":473},[384,388,391,396,399,404,423,428,445,451,456,467],[142,385,387],{"id":386},"placeholder-cover-art-needed","Placeholder: Cover Art Needed",[134,389,390],{},"Currently using Shrike Publishing logo as a placeholder.",[392,393,395],"h3",{"id":394},"artwork-requirements","Artwork Requirements",[134,397,398],{},"The cover art should capture the comedic heist energy of the game and include:",[134,400,401],{},[149,402,403],{},"Visual Elements:",[405,406,407,411,414,417,420],"ul",{},[408,409,410],"li",{},"The international prototype kilogram (a platinum-iridium cylinder under glass)",[408,412,413],{},"The diverse heist crew in action poses (5 characters representing the roles)",[408,415,416],{},"Climate-controlled vault or BIPM facility setting",[408,418,419],{},"Parisian aesthetic elements",[408,421,422],{},"Dynamic action composition suggesting both competence and chaos",[134,424,425],{},[149,426,427],{},"Style Direction:",[405,429,430,433,436,439,442],{},[408,431,432],{},"Comedic but not cartoonish",[408,434,435],{},"Energetic and action-packed",[408,437,438],{},"Vibrant colors that suggest both sophistication and fun",[408,440,441],{},"Modern tabletop game aesthetic",[408,443,444],{},"Should evoke Ocean's Eleven meets heist comedy",[134,446,447,450],{},[149,448,449],{},"Mood:","\nProfessional criminals doing something ridiculous with complete commitment.",[134,452,453],{},[149,454,455],{},"Dimensions:",[405,457,458,461,464],{},[408,459,460],{},"Primary: 2550 x 3300 pixels (300 DPI, standard game box cover ratio)",[408,462,463],{},"Web thumbnail: 600 x 776 pixels",[408,465,466],{},"Social media: 1200 x 630 pixels",[134,468,469,472],{},[149,470,471],{},"File Format:","\nHigh-resolution PNG or JPG with transparent PNG variant for flexible layouts",{"title":290,"searchDepth":291,"depth":291,"links":474},[475],{"id":386,"depth":291,"text":387,"children":476},[477],{"id":394,"depth":478,"text":395},3,"2024-11-01T00:00:00.000Z","Placeholder for the official cover art featuring the heist crew and the international prototype kilogram","/ShrikeLogoNov2021.png",{"artworkNeeded":125},"/artwork/steal-the-kilogram/cover",{"title":380,"description":480},"artwork/steal-the-kilogram/cover",[],"cover","x_FEVRObwBTjazE-YOs9DU9ZUqjPUEkN-s-TQnCO3oI",1761797169316]