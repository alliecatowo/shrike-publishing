[{"data":1,"prerenderedAt":644},["ShallowReactive",2],{"main-navigation":3,"game-steal-the-kilogram":122,"footer-content":476,"steal-the-kilogram-artwork":537},{"id":4,"extension":5,"items":6,"meta":89,"stem":120,"__hash__":121},"navigation/navigation/main.yaml","yaml",[7,11,31,47,61,73],{"label":8,"to":9,"icon":10},"Home","/","lucide:home",{"label":12,"icon":13,"children":14},"Games","lucide:gamepad-2",[15,19,23,27],{"label":16,"to":17,"icon":18},"All Games","/games","lucide:layout-grid",{"label":20,"to":21,"icon":22},"Era of Silence","/games/era-of-silence","lucide:book-heart",{"label":24,"to":25,"icon":26},"Blood Neon","/games/blood-neon","lucide:radiation",{"label":28,"to":29,"icon":30},"Steal the Kilogram","/games/steal-the-kilogram","lucide:scale",{"label":32,"icon":33,"children":34},"Writing","lucide:pen-line",[35,39,43],{"label":36,"to":37,"icon":38},"Stories","/stories","lucide:library",{"label":40,"to":41,"icon":42},"Poetry","/poetry","lucide:feather",{"label":44,"to":45,"icon":46},"Blog","/blog","lucide:rss",{"label":48,"icon":49,"children":50},"Shop","lucide:shopping-bag",[51,55,58],{"label":52,"to":53,"icon":54},"itch.io Store","https://shrikepublishing.itch.io/","lucide:external-link",{"label":56,"to":57,"icon":54},"DriveThruRPG","https://www.drivethrurpg.com/en/product/411680/era-of-silence-starter-kit",{"label":59,"to":60,"icon":54},"Ko-fi","https://ko-fi.com/shrikepublishing",{"label":62,"icon":63,"children":64},"Resources","lucide:folder",[65,69],{"label":66,"to":67,"icon":68},"Downloads","/resources","lucide:download",{"label":70,"to":71,"icon":72},"Licenses","/licenses","lucide:file-text",{"label":74,"icon":75,"children":76},"About","lucide:info",[77,81,85],{"label":78,"to":79,"icon":80},"About Robin","/about","lucide:user",{"label":82,"to":83,"icon":84},"Portfolio","/portfolio","lucide:briefcase",{"label":86,"to":87,"icon":88},"Contact","/contact","lucide:mail",{"path":90,"body":91,"title":119},"/navigation/main",{"items":92},[93,94,100,105,110,114],{"label":8,"to":9,"icon":10},{"label":12,"icon":13,"children":95},[96,97,98,99],{"label":16,"to":17,"icon":18},{"label":20,"to":21,"icon":22},{"label":24,"to":25,"icon":26},{"label":28,"to":29,"icon":30},{"label":32,"icon":33,"children":101},[102,103,104],{"label":36,"to":37,"icon":38},{"label":40,"to":41,"icon":42},{"label":44,"to":45,"icon":46},{"label":48,"icon":49,"children":106},[107,108,109],{"label":52,"to":53,"icon":54},{"label":56,"to":57,"icon":54},{"label":59,"to":60,"icon":54},{"label":62,"icon":63,"children":111},[112,113],{"label":66,"to":67,"icon":68},{"label":70,"to":71,"icon":72},{"label":74,"icon":75,"children":115},[116,117,118],{"label":78,"to":79,"icon":80},{"label":82,"to":83,"icon":84},{"label":86,"to":87,"icon":88},"Main","navigation/main","ttV2hx-8FyhWK_60qYhLTnApU2wAPB5d22U2jHRYQeo",{"id":123,"title":124,"available":125,"body":126,"coverImage":454,"currency":455,"date":456,"description":457,"extension":458,"featured":459,"image":460,"manualUrl":53,"meta":461,"navigation":125,"path":29,"playTime":454,"playerCount":454,"price":462,"published":125,"releaseDate":454,"resources":463,"seo":466,"slug":467,"stem":468,"tags":469,"thumbnail":454,"__hash__":475},"games/games/steal-the-kilogram.md","Get in Loser, We're Going to Steal the Kilogram",true,{"type":127,"value":128,"toc":431},"minimark",[129,133,138,142,145,149,152,156,161,164,168,171,175,178,182,217,221,225,245,249,266,270,282,285,288,292,303,313,323,327,340,349,359,363,370,379,383,395,399,405,411,417,423,426],[130,131,124],"h1",{"id":132},"get-in-loser-were-going-to-steal-the-kilogram",[134,135,137],"h2",{"id":136},"the-premise","The Premise",[139,140,141],"p",{},"The international prototype kilogram—the physical object that literally defined what a kilogram was for 130 years—sits in a vault in Paris. Your crew has decided that fundamental units of measurement should belong to the people, not locked behind bulletproof glass under the control of the International Bureau of Weights and Measures.",[139,143,144],{},"Also, it would be extremely funny to steal it.",[134,146,148],{"id":147},"what-is-this-game","What Is This Game?",[139,150,151],{},"A rules-light heist RPG for 2-5 players that takes 2-3 hours. One player is the Heist Caller (GM), the others are the crew. You'll plan an elaborate heist, watch it immediately go sideways, and improvise your way to either glory or catastrophic failure (probably both).",[134,153,155],{"id":154},"key-features","Key Features",[157,158,160],"h3",{"id":159},"dice-pool-chaos","Dice Pool Chaos",[139,162,163],{},"Roll d6s equal to your relevant skill. Every 4+ is a success. Every 1 is a complication. Yes, you can succeed AND create a disaster simultaneously. That's the point.",[157,165,167],{"id":166},"the-heist-deck","The Heist Deck",[139,169,170],{},"52 cards representing everything that can go wrong: security guards on smoke breaks, laser grids that weren't in the blueprints, your inside person who's actually terrible at their job, and the sudden realization that the kilogram is heavier than you expected (it's only a kilogram, but psychologically...).",[157,172,174],{"id":173},"flashback-mechanics","Flashback Mechanics",[139,176,177],{},"\"Oh, you needed a distraction? Good thing I befriended that mime troupe last week.\" Spend tokens to retroactively prepare for problems. Yes, this will make everything more complicated.",[157,179,181],{"id":180},"specialization-roles","Specialization Roles",[183,184,185,193,199,205,211],"ul",{},[186,187,188,192],"li",{},[189,190,191],"strong",{},"The Face",": You can talk your way into (and out of) anything",[186,194,195,198],{},[189,196,197],{},"The Brain",": You planned for this. Probably. Maybe.",[186,200,201,204],{},[189,202,203],{},"The Thief",": Locks, alarms, and other people's property are just suggestions",[186,206,207,210],{},[189,208,209],{},"The Muscle",": Sometimes the answer is \"apply force\"",[186,212,213,216],{},[189,214,215],{},"The Weird One",": You have a skill that shouldn't be useful but somehow always is",[134,218,220],{"id":219},"whats-included","What's Included",[157,222,224],{"id":223},"digital-version-15","Digital Version ($15)",[183,226,227,230,233,236,239,242],{},[186,228,229],{},"60-page PDF rulebook with examples and bad jokes",[186,231,232],{},"Printable character sheets",[186,234,235],{},"The Heist Deck (print-at-home)",[186,237,238],{},"Heist scenario: \"The Kilogram Job\"",[186,240,241],{},"Bonus scenarios: \"The Moon Rocks,\" \"The First Folio,\" \"Grandma's Ashes\"",[186,243,244],{},"Playlist suggestions (critical for ambiance)",[157,246,248],{"id":247},"physical-version-35-coming-soon","Physical Version ($35 - Coming Soon)",[183,250,251,254,257,260,263],{},[186,252,253],{},"Perfect-bound rulebook",[186,255,256],{},"Professional Heist Deck",[186,258,259],{},"Character sheet pad",[186,261,262],{},"Custom dice (because aesthetics matter)",[186,264,265],{},"Stickers with terrible measurement puns",[134,267,269],{"id":268},"why-this-game-exists","Why This Game Exists",[139,271,272,273,277,278,281],{},"We wanted a heist game that captured the energy of ",[274,275,276],"em",{},"Ocean's Eleven"," meets ",[274,279,280],{},"The Italian Job"," meets \"three disaster bisexuals and a grad student with a grappling hook.\"",[139,283,284],{},"Also, the kilogram thing is real. In 2019, they redefined the kilogram using fundamental constants instead of a physical object. Which means the original prototype is now just... a historical artifact. WHICH MEANS it's technically steal-able without destroying the global measurement system.",[139,286,287],{},"(Please don't actually steal the kilogram. This is a game.)",[134,289,291],{"id":290},"what-people-are-saying","What People Are Saying",[293,294,295,298],"blockquote",{},[139,296,297],{},"\"I laughed so hard I cried, and then I successfully stole the kilogram while disguised as a Belgian metrologist. 10/10.\"",[183,299,300],{},[186,301,302],{},"Player at GenCon 2024",[293,304,305,308],{},[139,306,307],{},"\"The rules are simple, the chaos is profound, and I now know way too much about the history of weights and measures.\"",[183,309,310],{},[186,311,312],{},"TableTop Gaming Review",[293,314,315,318],{},[139,316,317],{},"\"This game made me want to plan an actual heist, which I assume was not the intent but here we are.\"",[183,319,320],{},[186,321,322],{},"Anonymous (for legal reasons)",[134,324,326],{"id":325},"purchase-options","Purchase Options",[139,328,329,332,333],{},[189,330,331],{},"Digital Edition",": $15 USD - ",[334,335,339],"a",{"href":336,"rel":337},"https://shrikepublishing.itch.io/steal-the-kilogram",[338],"nofollow","Buy on itch.io",[139,341,342,345,346],{},[189,343,344],{},"Physical Edition",": $35 USD - Coming Q1 2025 - ",[334,347,348],{"href":87},"Get notified",[139,350,351,354,355],{},[189,352,353],{},"Print & Play",": Pay what you want - ",[334,356,358],{"href":336,"rel":357},[338],"Download from itch.io",[134,360,362],{"id":361},"license","License",[139,364,365,366,369],{},"This game is published under ",[189,367,368],{},"Creative Commons BY-NC-SA 4.0",". Run it for your friends, hack it for your table, remix it into something weirder. Just keep it non-commercial and credit us.",[139,371,372,373,378],{},"See our ",[334,374,377],{"href":375,"rel":376},"https://creativecommons.org/licenses/by-nc-sa/4.0/",[338],"full licensing information"," for details.",[134,380,382],{"id":381},"additional-resources","Additional Resources",[183,384,385,392],{},[186,386,387],{},[334,388,391],{"href":389,"rel":390},"https://shrikepublishing.itch.io/steal-the-kilogram/devlog",[338],"Community heist scenarios",[186,393,394],{},"Heist music playlist (coming soon!)",[134,396,398],{"id":397},"frequently-asked-questions","Frequently Asked Questions",[139,400,401,404],{},[189,402,403],{},"Q: Do I need to know anything about metrology to play this?","\nA: Absolutely not. The game teaches you everything you need, which is: \"It's shiny, it's French, and it's hilariously over-protected.\"",[139,406,407,410],{},[189,408,409],{},"Q: Can I use this system for other heists?","\nA: That's the whole point. Steal the kilogram, steal the moon rocks, steal the Constitution (we have a scenario for that).",[139,412,413,416],{},[189,414,415],{},"Q: Is this game political?","\nA: It's a game about stealing measuring standards from an international bureaucracy and redistributing them to the people, so... you tell us.",[139,418,419,422],{},[189,420,421],{},"Q: How replayable is it?","\nA: Extremely. The Heist Deck ensures every playthrough is different, and the flashback mechanic means players constantly invent new solutions.",[424,425],"hr",{},[139,427,428],{},[274,429,430],{},"Remember: Measurement is a social construct, but prison is real. Play responsibly.",{"title":432,"searchDepth":433,"depth":433,"links":434},"",2,[435,436,437,444,448,449,450,451,452,453],{"id":136,"depth":433,"text":137},{"id":147,"depth":433,"text":148},{"id":154,"depth":433,"text":155,"children":438},[439,441,442,443],{"id":159,"depth":440,"text":160},3,{"id":166,"depth":440,"text":167},{"id":173,"depth":440,"text":174},{"id":180,"depth":440,"text":181},{"id":219,"depth":433,"text":220,"children":445},[446,447],{"id":223,"depth":440,"text":224},{"id":247,"depth":440,"text":248},{"id":268,"depth":433,"text":269},{"id":290,"depth":433,"text":291},{"id":325,"depth":433,"text":326},{"id":361,"depth":433,"text":362},{"id":381,"depth":433,"text":382},{"id":397,"depth":433,"text":398},null,"USD","2024-11-10T00:00:00.000Z","A chaotic heist game about stealing the international prototype kilogram from a climate-controlled vault in Paris. For 2-5 players who believe measurement should belong to everyone.","md",false,"/ShrikeLogoNov2021.png",{},15,[464],{"title":465,"url":53},"Print & Play Version",{"title":124,"description":457},"steal-the-kilogram","games/steal-the-kilogram",[470,471,472,473,474],"tabletop","heist","comedy","one-shot","print-and-play","ddIqVU51hGEhEqoR4G3ImNGSGPG_xDPOH8hTO-dmm8s",{"id":477,"copyright":478,"extension":5,"meta":479,"sections":521,"social":530,"stem":535,"tagline":490,"__hash__":536},"footer/footer/main.yaml","© 2025 Shrike Publishing. All rights reserved.",{"path":480,"shop":481,"body":489,"title":119},"/footer/main",{"title":48,"links":482},[483,485,487],{"platform":484,"url":53,"icon":13},"itch.io",{"platform":56,"url":57,"icon":486},"lucide:book-open",{"platform":59,"url":60,"icon":488},"lucide:coffee",{"copyright":478,"tagline":490,"sections":491,"social":501,"shop":516},"Independent tabletop game publisher",[492],{"title":493,"links":494},"Quick Links",[495,496,497,498,499,500],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":502,"links":503},"Connect",[504,508,512],{"platform":505,"url":506,"icon":507},"Facebook","https://www.facebook.com/shrikepublishing","lucide:facebook",{"platform":509,"url":510,"icon":511},"Twitter","https://twitter.com/ShrikePublisher","lucide:twitter",{"platform":513,"url":514,"icon":515},"Instagram","https://www.instagram.com/shrikepublishing","lucide:instagram",{"title":48,"links":517},[518,519,520],{"platform":484,"url":53,"icon":13},{"platform":56,"url":57,"icon":486},{"platform":59,"url":60,"icon":488},[522],{"title":493,"links":523},[524,525,526,527,528,529],{"label":12,"to":17},{"label":36,"to":37},{"label":40,"to":41},{"label":62,"to":67},{"label":44,"to":45},{"label":74,"to":79},{"title":502,"links":531},[532,533,534],{"platform":505,"url":506,"icon":507},{"platform":509,"url":510,"icon":511},{"platform":513,"url":514,"icon":515},"footer/main","E2vBIIlIicogpOIWboNqz_CLlxsf1j0-c_bq-o2K-HA",[538],{"id":539,"title":540,"artist":541,"body":542,"date":635,"description":636,"extension":458,"featured":125,"fullImage":460,"game":467,"meta":637,"navigation":125,"path":638,"published":125,"seo":639,"stem":640,"tags":641,"thumbnail":460,"type":642,"__hash__":643},"artwork/artwork/steal-the-kilogram/cover.md","Steal the Kilogram - Game Cover","Shrike Team",{"type":127,"value":543,"toc":630},[544,548,551,555,558,563,580,585,602,608,613,624],[134,545,547],{"id":546},"placeholder-cover-art-needed","Placeholder: Cover Art Needed",[139,549,550],{},"Currently using Shrike Publishing logo as a placeholder.",[157,552,554],{"id":553},"artwork-requirements","Artwork Requirements",[139,556,557],{},"The cover art should capture the comedic heist energy of the game and include:",[139,559,560],{},[189,561,562],{},"Visual Elements:",[183,564,565,568,571,574,577],{},[186,566,567],{},"The international prototype kilogram (a platinum-iridium cylinder under glass)",[186,569,570],{},"The diverse heist crew in action poses (5 characters representing the roles)",[186,572,573],{},"Climate-controlled vault or BIPM facility setting",[186,575,576],{},"Parisian aesthetic elements",[186,578,579],{},"Dynamic action composition suggesting both competence and chaos",[139,581,582],{},[189,583,584],{},"Style Direction:",[183,586,587,590,593,596,599],{},[186,588,589],{},"Comedic but not cartoonish",[186,591,592],{},"Energetic and action-packed",[186,594,595],{},"Vibrant colors that suggest both sophistication and fun",[186,597,598],{},"Modern tabletop game aesthetic",[186,600,601],{},"Should evoke Ocean's Eleven meets heist comedy",[139,603,604,607],{},[189,605,606],{},"Mood:","\nProfessional criminals doing something ridiculous with complete commitment.",[139,609,610],{},[189,611,612],{},"Dimensions:",[183,614,615,618,621],{},[186,616,617],{},"Primary: 2550 x 3300 pixels (300 DPI, standard game box cover ratio)",[186,619,620],{},"Web thumbnail: 600 x 776 pixels",[186,622,623],{},"Social media: 1200 x 630 pixels",[139,625,626,629],{},[189,627,628],{},"File Format:","\nHigh-resolution PNG or JPG with transparent PNG variant for flexible layouts",{"title":432,"searchDepth":433,"depth":433,"links":631},[632],{"id":546,"depth":433,"text":547,"children":633},[634],{"id":553,"depth":440,"text":554},"2024-11-01T00:00:00.000Z","Placeholder for the official cover art featuring the heist crew and the international prototype kilogram",{"artworkNeeded":125},"/artwork/steal-the-kilogram/cover",{"title":540,"description":636},"artwork/steal-the-kilogram/cover",[],"cover","x_FEVRObwBTjazE-YOs9DU9ZUqjPUEkN-s-TQnCO3oI",1760662078028]