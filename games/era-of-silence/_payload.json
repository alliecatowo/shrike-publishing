,{"type":187,"value":447,"toc":608},[448,451,455,460,464,469,485,489,509,513,534,538,558,562,566,569,580,584,595,598],[190,449,445],{"id":450},"era-of-silence-quick-reference-guide",[195,452,454],{"id":453},"game-overview","Game Overview",[200,456,457,459],{},[224,458,20],{}," is a strategic card game for 2-4 players. In a world where words can kill, players must carefully manage when to speak and when to remain silent.",[195,461,463],{"id":462},"core-mechanics","Core Mechanics",[465,466,468],"h3",{"id":467},"the-silence-meter","The Silence Meter",[470,471,472,476,479,482],"ul",{},[473,474,475],"li",{},"Starts at 0",[473,477,478],{},"Increases when players speak (play cards)",[473,480,481],{},"When it reaches 10, triggers the Silence Cascade",[473,483,484],{},"Players can spend actions to reduce the meter",[465,486,488],{"id":487},"card-types","Card Types",[470,490,491,497,503],{},[473,492,493,496],{},[203,494,495],{},"Action Cards",": Perform game effects but increase the Silence Meter",[473,498,499,502],{},[203,500,501],{},"Silence Cards",": Reduce the Silence Meter or protect against cascades",[473,504,505,508],{},[203,506,507],{},"Event Cards",": Trigger special game effects",[465,510,512],{"id":511},"player-actions","Player Actions",[514,515,516,522,528],"ol",{},[473,517,518,521],{},[203,519,520],{},"Play Card",": Choose a card from hand to play",[473,523,524,527],{},[203,525,526],{},"Pass",": Skip your turn (safe but limited)",[473,529,530,533],{},[203,531,532],{},"Communicate",": Use hand signals to coordinate with allies",[195,535,537],{"id":536},"win-conditions","Win Conditions",[470,539,540,546,552],{},[473,541,542,545],{},[203,543,544],{},"Elimination",": Last player standing when others are silenced",[473,547,548,551],{},[203,549,550],{},"Objective",": Complete your secret objective before others",[473,553,554,557],{},[203,555,556],{},"Alliance",": Work with others to achieve mutual goals",[195,559,561],{"id":560},"advanced-rules","Advanced Rules",[465,563,565],{"id":564},"cascades","Cascades",[200,567,568],{},"When the Silence Meter reaches 10:",[470,570,571,574,577],{},[473,572,573],{},"All players discard cards",[473,575,576],{},"Special cascade effects trigger",[473,578,579],{},"Meter resets to 5",[465,581,583],{"id":582},"communication-limits","Communication Limits",[470,585,586,589,592],{},[473,587,588],{},"No verbal communication during play",[473,590,591],{},"Hand signals allowed",[473,593,594],{},"Written notes permitted but risky",[200,596,597],{},"Download the full rulebook for complete mechanics and strategy guides.",[200,599,600,604,605],{},[310,601,603],{"href":602},"/downloads/reference/era-of-silence-rulebook.pdf","Download Full Rulebook"," | ",[310,606,607],{"href":21},"Back to Game",{"title":321,"searchDepth":322,"depth":322,"links":609},[610,611,617,618],{"id":453,"depth":322,"text":454},{"id":462,"depth":322,"text":463,"children":612},[613,615,616],{"id":467,"depth":614,"text":468},3,{"id":487,"depth":614,"text":488},{"id":511,"depth":614,"text":512},{"id":536,"depth":322,"text":537},{"id":560,"depth":322,"text":561,"children":619},[620,621],{"id":564,"depth":614,"text":565},{"id":582,"depth":614,"text":583},"2024-09-20T00:00:00.000Z","Essential rules and mechanics for Era of Silence in a convenient reference format.","/downloads/reference/era-of-silence-quick-reference.pdf",{"slug":626},"era-of-silence-quick-reference",{"title":445,"description":623},"resources/era-of-silence-quick-reference",[20,630,631],"Rules","Quick Reference","quick-reference","ifSZc4sZe4Wwfw12mFRPkesg6fHwVSizRPw2NiHQRFk",{"id":635,"title":636,"body":637,"category":325,"date":646,"description":647,"download":643,"downloadUrl":325,"extension":329,"external":364,"file":643,"fileSize":325,"game":340,"image":325,"meta":648,"navigation":185,"pageCount":325,"path":650,"published":185,"seo":651,"stem":652,"tags":653,"type":375,"updatedAt":325,"url":325,"__hash__":655},"resources/resources/era-of-silence-the-pit-of-heaven-part-1.m