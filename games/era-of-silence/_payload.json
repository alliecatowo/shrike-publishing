,"body":807,"coverImage":322,"currency":323,"date":324,"description":325,"extension":326,"featured":185,"image":327,"manualUrl":57,"meta":894,"navigation":185,"path":21,"playTime":322,"playerCount":322,"price":329,"published":185,"releaseDate":322,"resources":895,"seo":898,"slug":192,"stem":337,"tags":899,"thumbnail":322,"__hash__":343},{"type":187,"value":808,"toc":886},[809,811,813,817,819,837,839,849,851,853,857,859,868,870,874,878,882],[190,810,20],{"id":192},[194,812,197],{"id":196},[199,814,201,815,205],{},[203,816,20],{},[194,818,209],{"id":208},[211,820,821,825,829,833],{},[214,822,823,220],{},[217,824,219],{},[214,826,827,226],{},[217,828,225],{},[214,830,831,232],{},[217,832,231],{},[214,834,835,238],{},[217,836,237],{},[194,838,242],{"id":241},[211,840,841,843,845,847],{},[214,842,247],{},[214,844,250],{},[214,846,253],{},[214,848,256],{},[194,850,260],{"id":259},[199,852,263],{},[199,854,855],{},[267,856,269],{"href":87},[194,858,273],{"id":272},[199,860,861,278,863,282,865,287],{},[203,862,20],{},[217,864,281],{},[267,866,56],{"href":57,"rel":867},[286],[194,869,291],{"id":290},[199,871,872],{},[203,873,296],{},[211,875,876],{},[214,877,301],{},[199,879,880],{},[203,881,306],{},[211,883,884],{},[214,885,311],{},{"title":313,"searchDepth":314,"depth":314,"links":887},[888,889,890,891,892,893],{"id":196,"depth":314,"text":197},{"id":208,"depth":314,"text":209},{"id":241,"depth":314,"text":242},{"id":259,"depth":314,"text":260},{"id":272,"depth":314,"text":273},{"id":290,"depth":314,"text":291},{},[896,897],{"title":332,"url":333},{"title":335,"url":67},{"title":20,"description":325},[339,340,341,342],{"id":901,"title":902,"available":185,"body":903,"coverImage":322,"currency":323,"date":1213,"description":1214,"extension":326,"featured":360,"image":1215,"manualUrl":53,"meta":1216,"navigation":185,"path":29,"playTime":322,"playerCount":322,"price":1217,"published":185,"releaseDate":322,"resources":1218,"seo":1221,"slug":1222,"stem":1223,"tags":1224,"thumbnail":322,"__hash__":1229},"games/games/steal-the-kilogram.md","Get in Loser, We're Going to Steal the Kilogram",{"type":187,"value":904,"toc":1193},[905,908,912,915,918,922,925,929,933,936,940,943,947,950,954,986,988,992,1012,1016,1033,1037,1048,1051,1054,1058,1069,1079,1089,1091,1102,1111,1121,1125,1132,1141,1145,1157,1161,1167,1173,1179,1185,1188],[190,906,902],{"id":907},"get-in-loser-were-going-to-steal-the-kilogram",[194,909,911],{"id":910},"the-premise","The Premise",[199,913,914],{},"The international prototype kilogram—the physical object that literally defined what a kilogram was for 130 years—sits in a vault in Paris. Your crew has decided that fundamental units of measurement should belong to the people, not locked behind bulletproof glass under the control of the International Bureau of Weights and Measures.",[199,916,917],{},"Also, it would be extremely funny to steal it.",[194,919,921],{"id":920},"what-is-this-game","What Is This Game?",[199,923,924],{},"A rules-light heist RPG for 2-5 players that takes 2-3 hours. One player is the Heist Caller (GM), the others are the crew. You'll plan an elaborate heist, watch it immediately go sideways, and improvise your way to either glory or catastrophic failure (probably both).",[194,926,928],{"id":927},"key-features","Key Features",[461,930,932],{"id":931},"dice-pool-chaos","Dice Pool Chaos",[199,934,935],{},"Roll d6s equal to your relevant skill. Every 4+ is a success. Every 1 is a complication. Yes, you can succeed AND create a disaster simultaneously. That's the point.",[461,937,939],{"id":938},"the-heist-deck","The Heist Deck",[199,941,942],{},"52 cards representing everything that can go wrong: security guards on smoke breaks, laser grids that weren't in the blueprints, your inside person who's actually terrible at their job, and the sudden realization that the kilogram is heavier than you expected (it's only a kilogram, but psychologically...).",[461,944,946],{"id":945},"flashback-mechanics","Flashback Mechanics",[199,948,949],{},"\"Oh, you needed a distraction? Good thing I befriended that mime troupe last week.\" Spend tokens to retroactively prepare for problems. Yes, this will make everything more complicated.",[461,951,953],{"id":952},"specialization-roles","Specialization Roles",[211,955,956,962,968,974,980],{},[214,957,958,961],{},[217,959,960],{},"The Face",": You can talk your way into (and out of) anything",[214,963,964,967],{},[217,965,966],{},"The Brain",": You planned for this. Probably. Maybe.",[214,969,970,973],{},[217,971,972],{},"The Thief",": Locks, alarms, and other people's property are just suggestions",[214,975,976,979],{},[217,977,978],{},"The Muscle",": Sometimes the answer is \"apply force\"",[214,981,982,985],{},[217,983,984],{},"The Weird One",": You have a skill that shouldn't be useful but somehow always is",[194,987,242],{"id":241},[461,989,991],{"id":990},"digital-version-15","Digital Version ($15)",[211,993,994,997,1000,1003,1006,1009],{},[214,995,996],{},"60-page PDF rulebook with examples and bad jokes",[214,998,999],{},"Printable character sheets",[214,1001,1002],{},"The Heist Deck (print-at-home)",[214,1004,1005],{},"Heist scenario: \"The Kilogram Job\"",[214,1007,1008],{},"Bonus scenarios: \"The Moon Rocks,\" \"The First Folio,\" \"Grandma's Ashes\"",[214,1010,1011],{},"Playlist suggestions (critical for ambiance)",[461,1013,1015],{"id":1014},"physical-version-35-coming-soon","Physical Version ($35 - Coming Soon)",[211,1017,1018,1021,1024,1027,1030],{},[214,1019,1020],{},"Perfect-bound rulebook",[214,1022,1023],{},"Professional Heist Deck",[214,1025,1026],{},"Character sheet pad",[214,1028,1029],{},"Custom dice (because aesthetics matter)",[214,1031,1032],{},"Stickers with terrible measurement puns",[194,1034,1036],{"id":1035},"why-this-game-exists","Why This Game Exists",[199,1038,1039,1040,1043,1044,1047],{},"We wanted a heist game that captured the energy of ",[203,1041,1042],{},"Ocean's Eleven"," meets ",[203,1045,1046],{},"The Italian Job"," meets \"three disaster bisexuals and a grad student with a grappling hook.\"",[199,1049,1050],{},"Also, the kilogram thing is real. In 2019, they redefined the kilogram using fundamental constants instead of a physical object. Which means the original prototype is now just... a historical artifact. WHICH MEANS it's technically steal-able without destroying the global measurement system.",[199,1052,1053],{},"(Please don't actually steal the kilogram. This is a game.)",[194,1055,1057],{"id":1056},"what-people-are-saying","What People Are Saying",[1059,1060,1061,1064],"blockquote",{},[199,1062,1063],{},"\"I laughed so hard I cried, and then I successfully stole the kilogram while disguised as a Belgian metrologist. 10/10.\"",[211,1065,1066],{},[214,1067,1068],{},"Player at GenCon 2024",[1059,1070,1071,1074],{},[199,1072,1073],{},"\"The rules are simple, the chaos is profound, and I now know way too much about the history of weights and measures.\"",[211,1075,1076],{},[214,1077,1078],{},"TableTop Gaming Review",[1059,1080,1081,1084],{},[199,1082,1083],{},"\"This game made me want to plan an actual heist, which I assume was not the intent but here we are.\"",[211,1085,1086],{},[214,1087,1088],{},"Anonymous (for legal reasons)",[194,1090,260],{"id":259},[199,1092,1093,1096,1097],{},[217,1094,1095],{},"Digital Edition",": $15 USD - ",[267,1098,1101],{"href":1099,"rel":1100},"https://shrikepublishing.itch.io/steal-the-kilogram",[286],"Buy on itch.io",[199,1103,1104,1107,1108],{},[217,1105,1106],{},"Physical Edition",": $35 USD - Coming Q1 2025 - ",[267,1109,1110],{"href":87},"Get notified",[199,1112,1113,1116,1117],{},[217,1114,1115],{},"Print & Play",": Pay what you want - ",[267,1118,1120],{"href":1099,"rel":1119},[286],"Download from itch.io",[194,1122,1124],{"id":1123},"license","License",[199,1126,1127,1128,1131],{},"This game is published under ",[217,1129,1130],{},"Creative Commons BY-NC-SA 4.0",". Run it for your friends, hack it for your table, remix it into something weirder. Just keep it non-commercial and credit us.",[199,1133,1134,1135,1140],{},"See our ",[267,1136,1139],{"href":1137,"rel":1138},"https://creativecommons.org/licenses/by-nc-sa/4.0/",[286],"full licensing information"," for details.",[194,1142,1144],{"id":1143},"additional-resources","Additional Resources",[211,1146,1147,1154],{},[214,1148,1149],{},[267,1150,1153],{"href":1151,"rel":1152},"https://shrikepublishing.itch.io/steal-the-kilogram/devlog",[286],"Community heist scenarios",[214,1155,1156],{},"Heist music playlist (coming soon!)",[194,1158,1160],{"id":1159},"frequently-asked-questions","Frequently Asked Questions",[199,1162,1163,1166],{},[217,1164,1165],{},"Q: Do I need to know anything about metrology to play this?","\nA: Absolutely not. The game teaches you everything you need, which is: \"It's shiny, it's French, and it's hilariously over-protected.\"",[199,1168,1169,1172],{},[217,1170,1171],{},"Q: Can I use this system for other heists?","\nA: That's the whole point. Steal the kilogram, steal the moon rocks, steal the Constitution (we have a scenario for that).",[199,1174,1175,1178],{},[217,1176,1177],{},"Q: Is this game political?","\nA: It's a game about stealing measuring standards from an international bureaucracy and redistributing them to the people, so... you tell us.",[199,1180,1181,1184],{},[217,1182,1183],{},"Q: How replayable is it?","\nA: Extremely. The Heist Deck ensures every playthrough is different, and the flashback mechanic means players constantly invent new solutions.",[1186,1187],"hr",{},[199,1189,1190],{},[203,1191,1192],{},"Remember: Measurement is a social construct, but prison is real. Play responsibly.",{"title":313,"searchDepth":314,"depth":314,"links":1194},[1195,1196,1197,1203,1207,1208,1209,1210,1211,1212],{"id":910,"depth":314,"text":911},{"id":920,"depth":314,"text":921},{"id":927,"depth":314,"text":928,"children":1198},[1199,1200,1201,1202],{"id":931,"depth":608,"text":932},{"id":938,"depth":608,"text":939},{"id":945,"depth":608,"text":946},{"id":952,"depth":608,"text":953},{"id":241,"depth":314,"text":242,"children":1204},[1205,1206],{"id":990,"depth":608,"text":991},{"id":1014,"depth":608,"text":1015},{"id":1035,"depth":314,"text":1036},{"id":1056,"depth":314,"text":1057},{"id":259,"depth":314,"text":260},{"id":1123,"depth":314,"text":1124},{"id":1143,"depth":314,"text":1144},{"id":1159,"depth":314,"text":1160},"2024-11-10T00:00:00.000Z","A chaotic heist game about stealing the international prototype kilogram from a climate-controlled vault in Paris. For 2-5 players who believe measurement should belong to everyone.","/ShrikeLogoNov2021.png",{},15,[1219],{"title":1220,"url":53},"Print & Play Version",{"title":902,"description":1214},"steal-the-kilogram","games/steal-the-kilogram",[339,1225,1226,1227,1228],"heist","comedy","one-shot","print-and-play","ddIqVU51hGEhEqoR4G3ImNGSGPG_xDPOH8hTO-dmm8s",1760581843306]