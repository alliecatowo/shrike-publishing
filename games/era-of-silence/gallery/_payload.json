abel":8,"to":9,"icon":10},{"label":12,"icon":13,"children":95},[96,97,98,99],{"label":16,"to":17,"icon":18},{"label":20,"to":21,"icon":22},{"label":24,"to":25,"icon":26},{"label":28,"to":29,"icon":30},{"label":32,"icon":33,"children":101},[102,103,104],{"label":36,"to":37,"icon":38},{"label":40,"to":41,"icon":42},{"label":44,"to":45,"icon":46},{"label":48,"icon":49,"children":106},[107,108,109],{"label":52,"to":53,"icon":54},{"label":56,"to":57,"icon":54},{"label":59,"to":60,"icon":54},{"label":62,"icon":63,"children":111},[112,113],{"label":66,"to":67,"icon":68},{"label":70,"to":71,"icon":72},{"label":74,"icon":75,"children":115},[116,117,118],{"label":78,"to":79,"icon":80},{"label":82,"to":83,"icon":84},{"label":86,"to":87,"icon":88},"Main","navigation/main","ttV2hx-8FyhWK_60qYhLTnApU2wAPB5d22U2jHRYQeo",{"id":123,"title":20,"available":124,"body":125,"coverImage":264,"currency":265,"date":266,"description":267,"extension":268,"featured":124,"image":269,"manualUrl":57,"meta":270,"navigation":124,"path":21,"playTime":264,"playerCount":264,"price":271,"published":124,"releaseDate":264,"resources":272,"seo":278,"slug":279,"stem":280,"tags":281,"thumbnail":264,"__hash__":286},"games/games/era-of-silence.md",true,{"type":126,"value":127,"toc":259},"minimark",[128,133,138,145,150,156,167,174,177,180,189,196,207,209,227,229,235,238,240,246,254],[129,130,132],"h1",{"id":131},"era-of-silence-rpg","Era of Silence RPG",[134,135,137],"h2",{"id":136},"tactical-chemipunk-action-for-teams-of-3-6-players","Tactical chemipunk action for teams of 3-6 players.",[139,140,141],"p",{},[142,143,144],"strong",{},"1000 years ago, the gods left us.",[139,146,147],{},[142,148,149],{},"400 years ago, our world was buried in ash.",[139,151,152,155],{},[142,153,154],{},"Now, we rely on alchemy and each other to survive."," ",[139,157,158,161,162],{},[142,159,160],{},"This is the"," ",[163,164,165],"em",{},[142,166,20],{},[139,168,169],{},[170,171],"img",{"alt":172,"src":173},"undefined","https://img.itch.zone/aW1nLzk2ODgzMDEuanBn/original/0BAo%2Fa.jpg",[139,175,176],{},"In the Long Silence, new monsters have shown their faces, from wasteland mutants to zealous fascists—no corner of the world is truly safe. Grab your team and get ready to fight your way across the shattered surface of Vian!",[178,179],"br",{},[139,181,182,184,185,188],{},[163,183,20],{}," is built on a roll-low dice pool system called ",[142,186,187],{},"Thorne",", designed to allow different characters to excel at the same task as the situation changes. Mixed with an interlocking Trait system, the game heavily emphasizes teamwork in a traditional RPG format! ",[139,190,191,161,193],{},[178,192],{},[170,194],{"alt":172,"src":195},"https://img.itch.zone/aW1nLzk2ODgyNDguanBn/original/bfLoDC.jpg",[139,197,198,199,202,203,206],{},"A streamlined character creation process offers ",[142,200,201],{},"over 15,000+ possible character combinations"," that **** can be chosen from in a single sitting. Play a thief with a penchant for machines, a mage with a military background, a combat alchemist, and more! Then grab gear that utilizes a ",[142,204,205],{},"Template + Mod system",". With just a few choices, a standard weapon turns into a trademark with its own twists and effects. ",[178,208],{},[139,210,211,212,214,215,218,219,222,223,226],{},"The core gameplay of ",[163,213,20],{}," is focused on intense, fast combats. A ",[142,216,217],{},"Stamina-focused action mechanic"," and a ",[142,220,221],{},"State system"," allow for tactical freedom in a way that's intuitive for both the Narrator and Protagonist Characters. This coupled with an ",[142,224,225],{},"HP-less damage mechanic"," creates an intense atmosphere where every attack feels lethal and helps combat resolve quickly!",[178,228],{},[139,230,231,232,234],{},"The setting, Vian, was once a place of magic, wonder, and purpose, ruled by the Divine Council. 1,000 years since and the world has been shattered and buried in ash by climate disaster. Yet the mortals the gods once ruled over still persist, surviving and even thriving thanks to alchemical technologies. They created shielded city-states with breathable air, potions that can cure wounds almost instantly, and surgeries that can completely reshape the mortal form! Some cling to hope that the gods may yet return, others have turned toward the idea of nations or empire, and some simply try to keep going and protect the ones they love. As for you, you will find your reason to keep going in the ",[163,233,20],{},". ",[139,236,237],{},"---",[178,239],{},[139,241,242,243,245],{},"The ",[163,244,20],{}," Starter Kit comes with a digital Core Rulebook, which is a 197-page PDF with hyperlinks between important entries and alternative text for all images. As well as a form-fillable character sheet, optional rules,  quick reference material, and an introductory module.",[139,247,248],{},[249,250,251],"a",{"href":251,"rel":252},"https://shrikepublishing.itch.io/era-of-silence",[253],"nofollow",[139,255,256],{},[170,257],{"alt":172,"src":258},"https://img.itch.zone/aW1nLzk2ODgzNTguanBn/original/Gqt2zp.jpg",{"title":260,"searchDepth":261,"depth":261,"links":262},"",2,[263],{"id":136,"depth":261,"text":137},null,"USD","2022-09-29T00:00:00.000Z","Team-focused tactical action in the gods' Long Silence.","md","/images/era-of-silence/cover/era-of-silence-cover.png",{},15,[273,276],{"title":274,"url":275},"Quick Reference Guide","/resources/era-of-silence-quick-reference",{"title":277,"url":67},"Character Sheets",{"title":20,"description":267},"era-of-silence","games/era-of-silence",[282,283,284,285],"tabletop","strategy","dystopian","card-game","kTUkUvfETdBHCBcAljyYMHqk0NKg9S4X0TDiFRbDm_8",{"id":288,"copyright":289,"extension":5,"meta":290,"sections":332,"social":341,"stem":346,"tagline":301,"__hash__":347},"footer/footer/main.yaml","© 2025 Shrike Publishing. All rights reserved.",{"path":291,"shop":292,"body":300,"title":119},"/footer/main",{"title":48,"links":293},[29