e":481,"description":489},"artwork/era-of-silence/creatures/ashcrawler",[],"creature","O0csFP8_DUtQvL5upIEw8MX-cLoSZEJjnXVGuSeZriE",{"id":499,"title":500,"artist":348,"body":501,"date":356,"description":508,"extension":265,"featured":358,"fullImage":509,"game":131,"meta":510,"navigation":124,"path":511,"published":124,"seo":512,"stem":513,"tags":514,"thumbnail":509,"type":496,"__hash__":515},"artwork/artwork/era-of-silence/creatures/bantam-spore.md","Era of Silence - Bantam Spore",{"type":126,"value":502,"toc":506},[503],[138,504,505],{},"Bantam Spores emerged from the biological contamination that followed the apocalypse. These fungal creatures spread their influence across the wasteland, representing the new life that has risen from humanity's fall.",{"title":252,"searchDepth":253,"depth":253,"links":507},[],"The Bantam Spore, a fungal creature born from the contaminated lands","/images/era-of-silence/art/creatures/bantam-spore.png",{},"/artwork/era-of-silence/creatures/bantam-spore",{"title":500,"description":508},"artwork/era-of-silence/creatures/bantam-spore",[],"fuFGQMgVyZkgt8OQxznK1bT0M1EbBGJRjmcoL-xvtsk",{"id":517,"title":518,"artist":348,"body":519,"date":356,"description":526,"extension":265,"featured":358,"fullImage":527,"game":131,"meta":528,"navigation":124,"path":529,"published":124,"seo":530,"stem":531,"tags":532,"thumbnail":527,"type":496,"__hash__":533},"artwork/artwork/era-of-silence/creatures/bantam-spore-variant.md","Era of Silence - Bantam Spore Variant",{"type":126,"value":520,"toc":524},[521],[138,522,523],{},"This variant of the Bantam Spore represents the rapid evolution occurring in Era of Silence's contaminated zones. Each generation of these creatures becomes more adapted to the harsh environment and more dangerous to human survivors.",{"title":252,"searchDepth":253,"depth":253,"links":525},[],"An evolved variant of the Bantam Spore with enhanced abilities and deadlier spore attacks","/images/era-of-silence/art/creatures/bantam-spore-variant.png",{},"/artwork/era-of-silence/creatures/bantam-spore-variant",{"title":518,"description":526},"artwork/era-of-silence/creatures/bantam-spore-variant",[],"spxIKxpd40DnGnnttUcbTVUSC65VOVvXEObvLzO7SsA",{"id":535,"title":536,"artist":348,"body":537,"date":356,"description":544,"extension":265,"featured":124,"fullImage":545,"game":131,"meta":546,"navigation":124,"path":547,"published":124,"seo":548,"stem":549,"tags":550,"thumbnail":545,"type":496,"__hash__":551},"artwork/artwork/era-of-silence/creatures/champion.md","Era of Silence - Champion",{"type":126,"value":538,"toc":542},[539],[138,540,541],{},"Champions are elite adversaries in Era of Silence, whether they are mutated humans, augmented warriors, or creatures that have claimed dominance over their territory. Encountering a Champion means facing one of the wasteland's greatest challenges.",{"title":252,"searchDepth":253,"depth":253,"links":543},[],"The Champion, a formidable enemy that stands between survivors and their goals","/images/era-of-silence/art/creatures/champion.png",{},"/artwork/era-of-silence/creatures/champion",{"title":536,"description":544},"artwork/era-of-silence/creatures/champion",[],"Vhv07U35bUDMjAWSX4SdFLs6U7cbUNqczJqcb2CMjrY",{"id":553,"title":554,"artist":348,"body":555,"date":263,"description":562,"extension":265,"featured":358,"fullImage":563,"game":131,"meta":564,"navigation":124,"path":565,"published":124,"seo":566,"stem":567,"tags":568,"thumbnail":563,"type":573,"__hash__":574},"artwork/artwork/era-of-silence/items/arm-augment.md","Arm Augment",{"type":126,"value":556,"toc":560},[557],[138,558,559],{},"This arm augmentation represents the fusion of biological and mechanical engineering in Era of Silence. Designed to enhance strength and precision, these augments are sought after by warriors and laborers alike, though their installation carries significant risks.",{"title":252,"searchDepth":253,"depth":253,"links":561},[],"A biomechanical arm augmentation enhancing strength and cap